# Collateral and short-video renders, footage, fonts and images live in Git LFS (same as apps/docs media).
collateral/**/*.png filter=lfs diff=lfs merge=lfs -text
collateral/**/*.jpg filter=lfs diff=lfs merge=lfs -text
collateral/**/*.pdf filter=lfs diff=lfs merge=lfs -text
collateral/**/*.woff2 filter=lfs diff=lfs merge=lfs -text
videos/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
videos/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
videos/**/*.jpg filter=lfs diff=lfs merge=lfs -text
videos/**/*.woff2 filter=lfs diff=lfs merge=lfs -text
