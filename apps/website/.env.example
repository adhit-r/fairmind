# PostHog remains dormant unless both values are configured and the visitor opts in through Olai.
PUBLIC_POSTHOG_KEY=phc_replace_with_fairmind_project_token
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Olai shows the consent notice. Without the origin and collection point the embed is not loaded,
# and without the analytics purpose key PostHog never starts.
PUBLIC_OLAI_API=
PUBLIC_OLAI_TENANT=default
PUBLIC_OLAI_COLLECTION_POINT=
PUBLIC_OLAI_ANALYTICS_PURPOSE=
