# PostHog remains dormant unless both values are configured and the external CMP opts analytics in.
PUBLIC_POSTHOG_KEY=phc_replace_with_fairmind_project_token
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Olai consent manager (notice, choices and the consent record for fairmind.xyz). Nothing loads unless all three are set.
PUBLIC_OLAI_API=https://olai.axonome.xyz
PUBLIC_OLAI_TENANT=
PUBLIC_OLAI_COLLECTION_POINT=
