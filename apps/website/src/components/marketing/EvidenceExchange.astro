<div class="exchange-shell" data-evidence-exchange data-source="environmental">
  <div class="exchange-toolbar">
    <div>
      <span class="exchange-signal" aria-hidden="true"></span>
      Interactive evidence exchange
    </div>
    <button type="button" class="exchange-replay" data-exchange-replay>
      Replay evidence chain
    </button>
  </div>

  <div class="exchange-world">
    <div class="exchange-stage" data-exchange-stage>
      <section class="exchange-source-stack" aria-label="Available evaluator paths">
        <p class="exchange-column-label">Evaluator output</p>
        <button
          type="button"
          class="exchange-source is-active"
          data-exchange-source="environmental"
          aria-pressed="true"
        >
          <span class="exchange-source-state">Validated path</span>
          <strong>Environmental evidence</strong>
          <small>Energy · carbon · water · uncertainty</small>
        </button>
        <button
          type="button"
          class="exchange-source"
          data-exchange-source="llm"
          aria-pressed="false"
        >
          <span class="exchange-source-state">External provider</span>
          <strong>LLM judge</strong>
          <small>Named provider · bounded assessment</small>
        </button>
        <button
          type="button"
          class="exchange-source"
          data-exchange-source="aibom"
          aria-pressed="false"
        >
          <span class="exchange-source-state">Metadata only</span>
          <strong>AI BOM profile</strong>
          <small>Inventory · bias records · unknowns</small>
        </button>
      </section>

      <section class="exchange-core" aria-labelledby="exchange-core-title">
        <div class="exchange-core-cap">FAIRMIND / EVIDENCE LAYER</div>
        <div class="exchange-core-body">
          <p class="exchange-core-state" data-exchange-capability>validated path</p>
          <h3 id="exchange-core-title" data-exchange-title>Environmental assessment</h3>
          <dl class="exchange-fields">
            <div>
              <dt>Subject</dt>
              <dd data-exchange-subject>Claims Assistant 2.4.1</dd>
            </div>
            <div>
              <dt>Evaluator</dt>
              <dd data-exchange-evaluator>FairMind-E / environmental</dd>
            </div>
            <div>
              <dt>Threshold</dt>
              <dd data-exchange-threshold>ENV gate / bounded</dd>
            </div>
            <div>
              <dt>Artifact</dt>
              <dd data-exchange-artifact>energy + carbon + uncertainty</dd>
            </div>
          </dl>
          <div class="exchange-integrity">
            <span>Context</span>
            <span>Provenance</span>
            <span>Limitations</span>
            <span>Review state</span>
          </div>
          <p class="exchange-limitation" data-exchange-limitation>
            Real hardware measurement is still required before research claims are treated as observed.
          </p>
        </div>
        <div class="exchange-core-foot">
          <span>Current workbench record</span>
          <span>Passport contract is the recovery target</span>
        </div>
      </section>

      <section class="exchange-decision-stack" aria-label="Governance outputs">
        <p class="exchange-column-label">Accountable workflow</p>
        <article class="exchange-output exchange-output-review">
          <span>Candidate mapping</span>
          <strong>Reviewer decision required</strong>
          <small>Nothing is accepted automatically.</small>
        </article>
        <article class="exchange-output exchange-output-finding">
          <span>Finding + remediation</span>
          <strong>Failure history retained</strong>
          <small>Clean retests link back to the failure.</small>
        </article>
        <article class="exchange-output exchange-output-package">
          <span>Assurance package</span>
          <strong>Framework-pinned evidence index</strong>
          <small>Decision support, never certification.</small>
        </article>
      </section>

      <span class="exchange-flow exchange-flow-in" aria-hidden="true"><i></i></span>
      <span class="exchange-flow exchange-flow-out" aria-hidden="true"><i></i></span>
    </div>
  </div>

  <div class="exchange-caption">
    <span>Pick an evaluator path</span>
    <p>Watch FairMind preserve the evidence boundary as the same record moves into review.</p>
  </div>
</div>

<script>
  const exchangeRecords = {
    environmental: {
      title: 'Environmental assessment',
      capability: 'validated path',
      subject: 'Claims Assistant 2.4.1',
      evaluator: 'FairMind-E / environmental',
      threshold: 'ENV gate / bounded',
      artifact: 'energy + carbon + uncertainty',
      limitation: 'Real hardware measurement is still required before research claims are treated as observed.',
    },
    llm: {
      title: 'Provider-backed LLM review',
      capability: 'external_provider',
      subject: 'Support Agent 4.8.0',
      evaluator: 'LLM judge / configured provider',
      threshold: 'Safety rubric / v1.3',
      artifact: 'response + verdict + provider identity',
      limitation: 'The result depends on a configured external model provider and its recorded identity.',
    },
    aibom: {
      title: 'AI BOM evidence profile',
      capability: 'metadata_only',
      subject: 'Claims Assistant 2.4.1',
      evaluator: 'AI BOM profile / transformation',
      threshold: 'Completeness / declared inputs',
      artifact: 'inventory + bias records + unknowns',
      limitation: 'The profile structures supplied metadata; it does not independently verify the subject.',
    },
  };

  document.querySelectorAll('[data-evidence-exchange]').forEach((exchange) => {
    if (!(exchange instanceof HTMLElement) || exchange.dataset.enhanced === 'true') return;
    exchange.dataset.enhanced = 'true';

    const stage = exchange.querySelector('[data-exchange-stage]');
    const sourceButtons = exchange.querySelectorAll('[data-exchange-source]');
    const replay = exchange.querySelector('[data-exchange-replay]');

    const setText = (selector, value) => {
      const element = exchange.querySelector(selector);
      if (element instanceof HTMLElement) element.textContent = value;
    };

    const activateSource = (source) => {
      const record = exchangeRecords[source];
      if (!record) return;

      exchange.dataset.source = source;
      exchange.classList.remove('is-switching');
      void exchange.offsetWidth;
      exchange.classList.add('is-switching');

      setText('[data-exchange-title]', record.title);
      setText('[data-exchange-capability]', record.capability);
      setText('[data-exchange-subject]', record.subject);
      setText('[data-exchange-evaluator]', record.evaluator);
      setText('[data-exchange-threshold]', record.threshold);
      setText('[data-exchange-artifact]', record.artifact);
      setText('[data-exchange-limitation]', record.limitation);

      sourceButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        const active = button.dataset.exchangeSource === source;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };

    sourceButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLButtonElement)) return;
        activateSource(button.dataset.exchangeSource || 'environmental');
      });
    });

    replay?.addEventListener('click', () => {
      exchange.classList.remove('is-replaying');
      void exchange.offsetWidth;
      exchange.classList.add('is-replaying');
    });

    if (!(stage instanceof HTMLElement) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    exchange.addEventListener('pointermove', (event) => {
      if (!(event instanceof PointerEvent) || event.pointerType === 'touch') return;
      const bounds = exchange.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - 0.5;
      const y = (event.clientY - bounds.top) / bounds.height - 0.5;
      stage.style.setProperty('--pointer-rx', `${(-y * 7).toFixed(2)}deg`);
      stage.style.setProperty('--pointer-ry', `${(x * 10).toFixed(2)}deg`);
    });

    exchange.addEventListener('pointerleave', () => {
      stage.style.setProperty('--pointer-rx', '0deg');
      stage.style.setProperty('--pointer-ry', '0deg');
    });
  });
</script>
