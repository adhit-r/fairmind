---
const capabilities = [
  { capability: 'Versioned assurance planning', status: 'Implemented', exposure: 'Internal', boundary: 'Plans bind exact target, suite, and execution-envelope identities.' },
  { capability: 'Evidence trust controls', status: 'Implemented', exposure: 'Default-off', boundary: 'Scope, signature, admission, replay, and freshness state support review.' },
  { capability: 'Reviewer and governance records', status: 'Implemented', exposure: 'Default-off', boundary: 'Human evidence review and governance decisions remain separate.' },
  { capability: 'Evaluator worker execution', status: 'Unavailable', exposure: 'Unmounted', boundary: 'No public worker route or general evaluator execution is provided.' },
  { capability: 'Automatic enforcement', status: 'Unavailable', exposure: 'Fail closed', boundary: 'Evidence never triggers automatic approval, remediation, or compliance action.' }
];
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2 class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-4">Release Status</h2>
      <h3 class="text-4xl font-bold text-gray-900 mb-4">What v2.1.0-alpha.1 Does and Does Not Do</h3>
      <p class="text-lg text-gray-600">
        A capability-state view of FairMind's internal, default-off P0 foundation. This is not a competitor comparison or a production-readiness claim.
      </p>
    </div>

    <div class="border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Capability</th>
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900 bg-gray-100">Status</th>
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Exposure</th>
              <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Boundary</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {capabilities.map((item) => (
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm font-medium text-gray-900">{item.capability}</td>
                <td class="px-6 py-4 text-sm text-gray-900 bg-gray-50">{item.status}</td>
                <td class="px-6 py-4 text-sm text-gray-600">{item.exposure}</td>
                <td class="px-6 py-4 text-sm text-gray-600">{item.boundary}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-12">
      <p class="text-gray-600 mb-6">Review the source and roadmap before relying on any release-scoped capability.</p>
      <a href="https://github.com/adhit-r/fairmind" target="_blank" class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 text-white font-medium hover:bg-gray-800 transition-colors">
        Review Source on GitHub
      </a>
    </div>
  </div>
</section>
