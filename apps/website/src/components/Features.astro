---
// Clean, professional features section
---

<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <h2 class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-4">Current Alpha Boundary</h2>
      <h3 class="text-4xl font-bold text-gray-900 mb-4">
        Evidence-Control-Plane Foundations
      </h3>
      <p class="text-lg text-gray-600">
        Internal and default-off controls for planning, admitting, and reviewing assurance evidence. Evaluator execution is not available.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Feature 1 -->
      <div class="bg-white p-8 border border-gray-200 hover:border-gray-300 transition-colors">
        <div class="w-12 h-12 bg-gray-900 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        
        <h4 class="text-xl font-bold text-gray-900 mb-3">Versioned Assurance Planning</h4>
        <p class="text-gray-600 mb-6">
          Bind a plan to an exact organization, system, target, suite version, and execution envelope.
        </p>
        
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Exact Target Identity</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Versioned Suite Identity</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Explicit Lifecycle State</span>
          </li>
        </ul>
      </div>

      <!-- Feature 2 -->
      <div class="bg-white p-8 border border-gray-200 hover:border-gray-300 transition-colors">
        <div class="w-12 h-12 bg-gray-900 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
        </div>
        
        <h4 class="text-xl font-bold text-gray-900 mb-3">Evidence Trust Controls</h4>
        <p class="text-gray-600 mb-6">
          Represent signature, scope, admission, freshness, replay, and limitation state without treating evidence as a conclusion.
        </p>
        
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Scope and Signature State</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Admission and Freshness State</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Replay-Aware Provenance</span>
          </li>
        </ul>
      </div>

      <!-- Feature 3 -->
      <div class="bg-white p-8 border border-gray-200 hover:border-gray-300 transition-colors">
        <div class="w-12 h-12 bg-gray-900 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        
        <h4 class="text-xl font-bold text-gray-900 mb-3">Human Review Boundaries</h4>
        <p class="text-gray-600 mb-6">
          Keep evidence review, trust state, and governance decisions separate and attributable.
        </p>
        
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Reviewer Attribution</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Recorded Limitations</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>No Automatic Approval</span>
          </li>
        </ul>
      </div>

      <!-- Feature 4 -->
      <div class="bg-white p-8 border border-gray-200 hover:border-gray-300 transition-colors">
        <div class="w-12 h-12 bg-gray-900 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        
        <h4 class="text-xl font-bold text-gray-900 mb-3">AI Bill of Materials — Planned</h4>
        <p class="text-gray-600 mb-6">
          The legacy API is quarantined while FairMind builds an authenticated, tenant-scoped replacement.
        </p>
        
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Tenant-safe inventory boundary</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Scoped component provenance</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Independent release validation</span>
          </li>
        </ul>
      </div>

      <!-- Feature 5 -->
      <div class="bg-white p-8 border border-gray-200 hover:border-gray-300 transition-colors">
        <div class="w-12 h-12 bg-gray-900 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        
        <h4 class="text-xl font-bold text-gray-900 mb-3">Fail-Closed Feature Gates</h4>
        <p class="text-gray-600 mb-6">
          Keep unsupported capability surfaces unmounted or explicitly unavailable rather than implying results exist.
        </p>
        
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Exact Permission Checks</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Default-Off Exposure</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>Explicit Unavailable States</span>
          </li>
        </ul>
      </div>

      <!-- Feature 6 -->
      <div class="bg-white p-8 border border-gray-200 hover:border-gray-300 transition-colors">
        <div class="w-12 h-12 bg-gray-900 flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        
        <h4 class="text-xl font-bold text-gray-900 mb-3">Evaluator Execution — Unavailable</h4>
        <p class="text-gray-600 mb-6">
          The alpha does not provide worker execution, public evaluator packs, continuous monitoring, or automatic enforcement.
        </p>
        
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>No Worker Runtime</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>No Public Evaluator Packs</span>
          </li>
          <li class="flex items-start">
            <span class="mr-2">•</span>
            <span>No Automatic Enforcement</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- CTA -->
    <div class="mt-16 text-center">
      <a 
        href="/features" 
        class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 text-white font-medium hover:bg-gray-800 transition-colors"
      >
        Review Capability Status
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
