---
// Clean minimal how it works component
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <h2 class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-4">How It Works</h2>
      <h3 class="text-4xl font-bold text-gray-900 mb-4">
        A Bounded 5-Step Evidence Flow
      </h3>
      <p class="text-lg text-gray-600">
        Organize evidence for human review without implying evaluator execution, certification, or compliance.
      </p>
    </div>

    <!-- Process Steps -->
    <div class="space-y-12">
      
      <!-- Step 1 -->
      <div class="flex gap-8 items-start">
        <div class="flex-shrink-0">
          <div class="w-12 h-12 bg-gray-900 flex items-center justify-center">
            <span class="text-white font-bold text-lg">1</span>
          </div>
        </div>
        <div class="flex-1">
          <h4 class="text-xl font-bold text-gray-900 mb-2">Define Scope</h4>
          <p class="text-gray-600 mb-4">
            Bind the work to an exact organization, system, target, suite version, and execution envelope.
          </p>
          <ul class="space-y-1 text-sm text-gray-600">
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Organization and System Identity</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Target and Suite Version</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Execution Envelope</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex gap-8 items-start">
        <div class="flex-shrink-0">
          <div class="w-12 h-12 bg-gray-900 flex items-center justify-center">
            <span class="text-white font-bold text-lg">2</span>
          </div>
        </div>
        <div class="flex-1">
          <h4 class="text-xl font-bold text-gray-900 mb-2">Prepare an Evidence Run</h4>
          <p class="text-gray-600 mb-4">
            Plan and preflight an evidence-awaiting run. FairMind evaluator execution is unavailable in this alpha.
          </p>
          <ul class="space-y-1 text-sm text-gray-600">
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Versioned Run Plan</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Preflight State</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Explicit Execution Boundary</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex gap-8 items-start">
        <div class="flex-shrink-0">
          <div class="w-12 h-12 bg-gray-900 flex items-center justify-center">
            <span class="text-white font-bold text-lg">3</span>
          </div>
        </div>
        <div class="flex-1">
          <h4 class="text-xl font-bold text-gray-900 mb-2">Submit Evidence</h4>
          <p class="text-gray-600 mb-4">
            Submit signed or imported evidence through internal, default-off controls with exact scope and provenance.
          </p>
          <ul class="space-y-1 text-sm text-gray-600">
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Passport Binding</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Source Provenance</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Admission State</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="flex gap-8 items-start">
        <div class="flex-shrink-0">
          <div class="w-12 h-12 bg-gray-900 flex items-center justify-center">
            <span class="text-white font-bold text-lg">4</span>
          </div>
        </div>
        <div class="flex-1">
          <h4 class="text-xl font-bold text-gray-900 mb-2">Review Trust State</h4>
          <p class="text-gray-600 mb-4">
            Inspect signer, source, admission, freshness, review, and limitation state without automatic trust.
          </p>
          <ul class="space-y-1 text-sm text-gray-600">
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Freshness and Revocation</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Replay and Conflict State</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Documented Limitations</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Step 5 -->
      <div class="flex gap-8 items-start">
        <div class="flex-shrink-0">
          <div class="w-12 h-12 bg-gray-900 flex items-center justify-center">
            <span class="text-white font-bold text-lg">5</span>
          </div>
        </div>
        <div class="flex-1">
          <h4 class="text-xl font-bold text-gray-900 mb-2">Record a Human Decision</h4>
          <p class="text-gray-600 mb-4">
            Keep reviewer findings and governance decisions distinct. The record is not certification or automatic enforcement.
          </p>
          <ul class="space-y-1 text-sm text-gray-600">
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Reviewer Attribution</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>Governance Decision State</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2">•</span>
              <span>No Automatic Certification</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>
