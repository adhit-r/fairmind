---
import { frameworks } from '../../lib/frameworks';

const currentYear = new Date().getFullYear();

const columns = [
  {
    title: 'Platform',
    links: [
      { label: 'Features', href: '/features/' },
      { label: 'Product walkthrough', href: '/demo/' },
      { label: 'Use cases', href: '/use-cases/' },
      { label: 'Compare tools', href: '/comparison/' },
      { label: 'Roadmap', href: '/roadmap/' },
    ],
  },
  {
    title: 'Frameworks',
    links: frameworks.map((f) => ({ label: f.shortName, href: `/frameworks/${f.slug}/` })),
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Research', href: '/blog/' },
      { label: 'Docs', href: 'https://docs.fairmind.xyz' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Request access', href: '/request-access/' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
      { label: 'Cookies', href: '/cookies/' },
      { label: 'Data retention', href: '/data-retention/' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer-grid">
      <div>
        <a class="brand" href="/">
          <img src="/logo-mark.svg" alt="" width="30" height="30" loading="lazy" />
          <span>FairMind</span>
        </a>
        <p>Agentic AI governance, built by Axonome. Agents do the paperwork; people keep the decisions.</p>
      </div>
      {columns.map((column) => (
        <nav aria-label={column.title}>
          <h2>{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="site-footer-legal">
      <p>© {currentYear} Axonome. All rights reserved.</p>
      <p>FairMind supports governance decisions. It does not certify AI systems.</p>
    </div>
  </div>
</footer>
