---
import { registryTotals } from '../lib/registry';
import '../styles/global.css';
import Analytics from '../components/marketing/Analytics.astro';
import Footer from '../components/layout/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  structuredData?: object | object[];
}

const {
  title,
  description = `FairMind is an agentic AI governance platform. Governance runs as agent workflows mapped to ${registryTotals.frameworks} frameworks, and a person decides at every gate.`,
  image = '/og-image.png',
  imageAlt = 'FairMind: governance that runs itself, decisions that stay human',
  canonical,
  noindex = false,
  structuredData,
} = Astro.props;

const site = Astro.site ?? new URL('https://fairmind.xyz');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = canonical ?? new URL(path, site).href;
const imageURL = new URL(image, site).href;

const nav = [
  { label: 'Platform', href: '/features/' },
  { label: 'Frameworks', href: '/frameworks/' },
  { label: 'Use cases', href: '/use-cases/' },
  { label: 'Research', href: '/research/' },
];
const isCurrent = (href: string) => path.startsWith(href);

const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://fairmind.xyz/#organization',
    name: 'FairMind',
    url: 'https://fairmind.xyz',
    logo: 'https://fairmind.xyz/logo-mark.png',
    parentOrganization: { '@type': 'Organization', name: 'Axonome', url: 'https://axonome.xyz' },
    sameAs: ['https://github.com/adhit-r/fairmind'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://fairmind.xyz/#website',
    name: 'FairMind',
    url: 'https://fairmind.xyz',
    publisher: { '@id': 'https://fairmind.xyz/#organization' },
  },
];
const pageSchema = structuredData ? [structuredData].flat() : [];
const appUrl = import.meta.env.PUBLIC_APP_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" href="/logo-mark.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FairMind" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap"
    />

    {[...siteSchema, ...pageSchema].map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header-inner">
        <a class="brand" href="/" aria-label="FairMind home">
          <img src="/logo-mark.svg" alt="" width="30" height="30" />
          <span>FairMind</span>
        </a>

        <nav class="desktop-navigation" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href="https://docs.fairmind.xyz">Docs</a>
        </nav>

        <div class="header-actions">
          <a class="header-sign-in" href={`${appUrl}/login`}>Sign in</a>
          <a class="button button-primary button-compact" href="/request-access/">Request access</a>
        </div>

        <details class="mobile-navigation" data-mobile-navigation>
          <summary>Menu</summary>
          <nav aria-label="Mobile">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href="https://docs.fairmind.xyz">Docs</a>
            <a href={`${appUrl}/login`}>Sign in</a>
            <a href="/request-access/">Request access</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      document.querySelectorAll('[data-mobile-navigation] a').forEach((link) => {
        link.addEventListener('click', () => {
          const menu = link.closest('details');
          if (menu instanceof HTMLDetailsElement) menu.open = false;
        });
      });

      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }),
        { threshold: 0.15 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      if (!reduceMotion && matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('[data-magnet]').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.25}px, ${(e.clientY - r.top - r.height / 2) * 0.35}px)`;
          });
          el.addEventListener('pointerleave', () => (el.style.transform = ''));
        });
        document.querySelectorAll<HTMLElement>('.tilt').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            el.style.transform = `perspective(1000px) rotateX(${-y * 9}deg) rotateY(${x * 9}deg) translateY(-6px)`;
          });
          el.addEventListener('pointerleave', () => (el.style.transform = ''));
        });
      }
    </script>
  </body>
</html>
