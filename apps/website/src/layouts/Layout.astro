---
import '../styles/global.css';
import Analytics from '../components/marketing/Analytics.astro';
import Footer from '../components/layout/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  structuredData?: object | object[];
}

const {
  title,
  description = 'FairMind detects AI bias, tracks every fix to a retest, and maps the evidence to the EU AI Act, DPDP Act, NITI Aayog principles, and NIST AI RMF.',
  image = '/og-image.png',
  imageAlt = 'FairMind: AI bias detection and governance evidence',
  canonical,
  noindex = false,
  structuredData,
} = Astro.props;

const site = Astro.site ?? new URL('https://fairmind.xyz');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = canonical ?? new URL(path, site).href;
const imageURL = new URL(image, site).href;

const nav = [
  { label: 'Platform', href: '/features/' },
  { label: 'Frameworks', href: '/frameworks/' },
  { label: 'Use cases', href: '/use-cases/' },
  { label: 'Research', href: '/blog/' },
];
const isCurrent = (href: string) => path.startsWith(href);

const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://fairmind.xyz/#organization',
    name: 'FairMind',
    url: 'https://fairmind.xyz',
    logo: 'https://fairmind.xyz/logo-mark.png',
    parentOrganization: { '@type': 'Organization', name: 'Axonome', url: 'https://axonome.xyz' },
    sameAs: ['https://github.com/adhit-r/fairmind'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://fairmind.xyz/#website',
    name: 'FairMind',
    url: 'https://fairmind.xyz',
    publisher: { '@id': 'https://fairmind.xyz/#organization' },
  },
];
const pageSchema = structuredData ? [structuredData].flat() : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#0d0f0e" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/logo-mark.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FairMind" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=IBM+Plex+Mono:wght@500&family=Inter+Tight:wght@400;500;600;700&display=swap"
    />

    {[...siteSchema, ...pageSchema].map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header-inner">
        <a class="brand" href="/" aria-label="FairMind home">
          <img src="/logo-mark.png" alt="" width="36" height="36" />
          <span>FairMind</span>
        </a>

        <nav class="desktop-navigation" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href="https://docs.fairmind.xyz">Docs</a>
        </nav>

        <div class="header-actions">
          <a class="header-sign-in" href="https://app.fairmind.io">Sign in</a>
          <a class="button button-primary button-compact" href="/request-access/">Request access</a>
        </div>

        <details class="mobile-navigation" data-mobile-navigation>
          <summary>Menu</summary>
          <nav aria-label="Mobile">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href="https://docs.fairmind.xyz">Docs</a>
            <a href="https://app.fairmind.io">Sign in</a>
            <a href="/request-access/">Request access</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      document.querySelectorAll('[data-mobile-navigation] a').forEach((link) => {
        link.addEventListener('click', () => {
          const menu = link.closest('details');
          if (menu instanceof HTMLDetailsElement) menu.open = false;
        });
      });
    </script>
  </body>
</html>
