---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  structuredData?: object;
}

const {
  title,
  description = "FairMind v2.1.0-alpha.1 is an internal, default-off evidence-control-plane foundation for versioned planning, scoped evidence, trust state, and human review.",
  image = "/og-image.png",
  canonical,
  noindex = false,
  structuredData
} = Astro.props;

const canonicalURL = canonical || Astro.url.href;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />
    <meta name="language" content="English" />
    <meta name="author" content="Fairmind AI Governance Platform" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:site_name" content="FairMind" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
    <!-- Additional Meta Tags -->
    <meta name="keywords" content="AI governance, assurance evidence, evidence control plane, assurance planning, evidence provenance, trust state, human review, model governance, AI risk evidence" />
    <meta name="theme-color" content="#EAB308" />
    <meta name="msapplication-TileColor" content="#EAB308" />
    
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "FairMind",
      "url": "https://fairmind.xyz"
    })} />
    
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "FairMind",
      "url": "https://fairmind.xyz",
      "logo": "https://fairmind.xyz/logo.png",
      "sameAs": ["https://github.com/adhit-r/fairmind"]
    })} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    
  </head>
  
  <body class="font-sans antialiased bg-white text-gray-900">
    <!-- Header -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-4">
          <!-- Logo -->
          <div class="flex items-center">
            <a href="/" class="flex items-center space-x-2">
              <img 
                src="/logo.png" 
                alt="FairMind Logo" 
                class="h-8 w-auto"
                width="32"
                height="32"
              />
              <span class="text-lg font-bold text-gray-900">FairMind</span>
            </a>
          </div>
          
          <!-- Navigation -->
          <nav class="hidden md:flex items-center space-x-8">
            <a href="/features" class="text-gray-600 hover:text-gray-900 font-medium transition-colors">Features</a>
            <a href="https://github.com/adhit-r/fairmind/tree/main/apps/docs/content/docs" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900 font-medium transition-colors">Repository Docs</a>
            <a href="/comparison" class="text-gray-600 hover:text-gray-900 font-medium transition-colors">Comparison</a>
          </nav>
          
          <!-- CTA Buttons -->
          <div class="flex items-center space-x-4">
            <a href="https://github.com/adhit-r/fairmind" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900 font-medium transition-colors">GitHub</a>
            <a href="/contact" class="bg-gray-900 text-white px-4 py-2 font-medium hover:bg-gray-800 transition-colors">
              Contact
            </a>
          </div>
        </div>
      </div>
    </header>
    
    <!-- Main Content -->
    <main>
      <slot />
    </main>
    
    <!-- Footer -->
    <footer class="bg-gray-50 border-t border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Company Info -->
          <div class="col-span-1 md:col-span-2">
            <div class="flex items-center space-x-2 mb-4">
              <div class="w-6 h-6 bg-gray-900 flex items-center justify-center">
                <span class="text-white font-bold text-xs">FM</span>
              </div>
              <span class="text-base font-bold text-gray-900">FairMind</span>
            </div>
            <p class="text-gray-600 mb-4 max-w-md">
              Internal alpha foundation for scoped assurance evidence, explicit trust state, and human review. It does not certify compliance or execute evaluators.
            </p>
            <div class="flex space-x-4">
              <a href="https://github.com/adhit-r/fairmind" target="_blank" rel="noopener noreferrer" aria-label="FairMind source repository" class="text-gray-400 hover:text-gray-600 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            </div>
          </div>
          
          <!-- Product -->
          <div>
            <h3 class="text-sm font-semibold text-gray-900 mb-4">Product</h3>
            <ul class="space-y-2">
              <li><a href="/features" class="text-gray-600 hover:text-gray-900 text-sm transition-colors">Features</a></li>
              <li><a href="/comparison" class="text-gray-600 hover:text-gray-900 text-sm transition-colors">Comparison</a></li>
              <li><a href="https://github.com/adhit-r/fairmind" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900 text-sm transition-colors">GitHub</a></li>
            </ul>
          </div>
          
          <!-- Resources -->
          <div>
            <h3 class="text-sm font-semibold text-gray-900 mb-4">Resources</h3>
            <ul class="space-y-2">
              <li><a href="https://github.com/adhit-r/fairmind/tree/main/apps/docs/content/docs" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900 text-sm transition-colors">Repository Docs</a></li>
              <li><a href="https://github.com/adhit-r/fairmind/blob/main/docs/superpowers/plans/2026-07-19-fairmind-2027-ai-assurance-todo.md" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900 text-sm transition-colors">Capability Roadmap</a></li>
              <li><a href="/contact" class="text-gray-600 hover:text-gray-900 text-sm transition-colors">Contact</a></li>
            </ul>
          </div>
        </div>
        
        <div class="border-t border-gray-200 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center">
          <p class="text-gray-500 text-sm">
            © 2026 FairMind. All rights reserved.
          </p>
          <p class="text-gray-500 text-sm mt-4 md:mt-0">P0 alpha · no analytics or access-form data collection</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  html {
    font-family: 'Inter', system-ui, sans-serif;
  }
  
  body {
    margin: 0;
    padding: 0;
    background-color: #000000;
    color: #EAB308;
  }
  
  * {
    box-sizing: border-box;
  }
</style>
