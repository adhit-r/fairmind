---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import '../styles/pages.css';

const workflow = [
  ['System boundary', 'Define what is actually under review.', 'Organization, workspace, AI system, version, owner, deployment, intended use, and applicable frameworks.'],
  ['Evaluation run', 'Run or ingest a bounded test.', 'Record evaluator identity, metric version, prompt or dataset scope, threshold, result, and capability state.'],
  ['Evidence record', 'Preserve the artifact and its limits.', 'Bind provenance, integrity information, raw output, limitations, and the exact subject that produced it.'],
  ['Reviewer decision', 'Keep technical output separate from governance acceptance.', 'Candidate mappings require an accountable person to accept, reject, or narrow them with rationale.'],
  ['Finding and retest', 'Retain failure history after remediation.', 'Link finding, risk, owner, remediation, exception, and clean rerun without erasing the earlier failure.'],
  ['Assurance package', 'Compile decision-ready evidence.', 'Export a framework-pinned index for a stated evidence cutoff—decision support, never certification.'],
];

const capabilities = [
  ['Environmental evidence', 'validated', 'Energy, carbon, water, uncertainty, mitigation, exception, and reviewer records.', 'Real hardware evidence is still required before paper claims are treated as observed.'],
  ['Provider-backed LLM judge', 'external_provider', 'Bounded assessment with provider identity and rubric version.', 'Requires a configured provider and preserves that dependency as a limitation.'],
  ['AI BOM fairness profile', 'metadata_only', 'Transforms inventory, bias, remediation, and unknown metadata.', 'It structures supplied metadata; it does not independently evaluate the system.'],
  ['Multimodal group analysis', 'metadata_only', 'Distribution analysis over caller-supplied labels.', 'Media content itself is not evaluated.'],
  ['Tabular bias', 'unavailable', 'No evidence-grade active route.', 'Unavailable must remain unavailable until a real contract closes.'],
  ['Modern LLM bias', 'unavailable', 'Mock output cannot enter assurance packages.', 'Browser-generated results and pass fallbacks are excluded.'],
];
---

<Layout
  title="FairMind features | The AI assurance evidence layer"
  description="Define AI systems, ingest evaluation results, preserve evidence boundaries, route human review, retain remediation and retests, and compile assurance packages."
>
  <div class="route-page">
    <PageHero
      signal="AI evaluation · AI safety · AI governance"
      title="The feature is the"
      accent="evidence chain."
      description="FairMind sits between evaluator tools and governance decisions. It gives every result a subject, threshold, artifact, limitation, review state, finding, remediation, and rerun—so a test can become evidence without pretending to become compliance."
      proofs={[
        { label: 'Input', value: 'Evaluator output', note: 'Run a supported path or ingest a result from a tool your team already trusts.' },
        { label: 'FairMind adds', value: 'Chain of custody', note: 'Identity, threshold, artifacts, limitations, review, findings, and retests.' },
        { label: 'Output', value: 'Decision-ready package', note: 'Framework-pinned evidence for a stated cutoff and accountable reviewer.' },
      ]}
      primary={{ label: 'Follow the workflow', href: '#workflow' }}
      secondary={{ label: 'Check capability truth', href: '#capability-register' }}
    />

    <section class="route-section" id="workflow" aria-labelledby="workflow-title">
      <header class="route-section-heading">
        <h2 id="workflow-title">Six jobs, one durable record.</h2>
        <p>The product is organized around the work required to defend a decision—not a collection of unrelated dashboards.</p>
      </header>
      <div class="route-ledger">
        {workflow.map((item, index) => (
          <article class="route-ledger-row">
            <span>{String(index + 1).padStart(2, '0')} / {item[0]}</span>
            <h3>{item[1]}</h3>
            <p>{item[2]}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="route-section route-section-dark" aria-labelledby="passport-title">
      <div class="route-split">
        <div class="route-split-copy">
          <h2 id="passport-title">The Evidence Passport is the target exchange contract.</h2>
          <p>FairMind’s novelty is not another universal trust score. It is a portable, reviewable unit that binds technical evidence to the human decisions and later changes that give it governance meaning.</p>
        </div>
        <div class="route-checklist">
          {['Exact subject and version', 'Evaluator and metric identity', 'Pre-registered threshold', 'Artifact integrity and raw output', 'Limitations and capability state', 'Reviewer decision and rationale', 'Finding, remediation, and exception', 'Superseding rerun without erased history'].map((item, index) => (
            <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></div>
          ))}
        </div>
      </div>
    </section>

    <section class="route-section" id="capability-register" aria-labelledby="capability-title">
      <header class="route-section-heading">
        <h2 id="capability-title">Capability state travels with the evidence.</h2>
        <p>These are implementation boundaries, not maturity grades. A route can be useful and still be bounded.</p>
      </header>
      <div class="route-table-wrap">
        <table class="route-table">
          <thead><tr><th>Evaluator path</th><th>State</th><th>What it can produce</th><th>Boundary</th></tr></thead>
          <tbody>
            {capabilities.map((row) => (
              <tr><td><strong>{row[0]}</strong></td><td><span class="route-state">{row[1]}</span></td><td>{row[2]}</td><td>{row[3]}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="route-closing" aria-labelledby="features-closing-title">
      <div><p>Start with one real evaluator output</p><h2 id="features-closing-title">Make the evidence boundary visible.</h2></div>
      <div class="route-actions">
        <a class="button button-primary" href="/request-access">Request access</a>
        <a class="button button-secondary" href="/roadmap">Read the recovery roadmap</a>
      </div>
    </section>
  </div>
</Layout>
