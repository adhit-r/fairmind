---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    title: 'Versioned Assurance Planning',
    description: 'Create scoped planning records bound to exact organization, system, target, suite version, and execution-envelope identities.',
    highlights: ['Exact target identity', 'Versioned suite identity', 'Explicit lifecycle state', 'Evidence-awaiting run state']
  },
  {
    title: 'Execution and Passport Binding',
    description: 'Keep claimed execution context and evidence metadata linked without claiming that FairMind executed an evaluator.',
    highlights: ['Execution-envelope binding', 'Passport identity', 'Source provenance', 'Recorded limitations']
  },
  {
    title: 'Evidence Trust Controls',
    description: 'Represent scope, signer, admission, freshness, replay, conflict, and revocation state for human review.',
    highlights: ['Signature state', 'Admission state', 'Freshness state', 'Replay-aware provenance']
  },
  {
    title: 'Reviewer and Governance Separation',
    description: 'Record evidence review and governance decisions as distinct, attributable human actions.',
    highlights: ['Reviewer attribution', 'Governance decision state', 'Human approval boundary', 'No automatic certification']
  },
  {
    title: 'Explicit Capability Gates',
    description: 'Default-off and unsupported surfaces remain unavailable rather than displaying fabricated results.',
    highlights: ['Fail-closed exposure', 'Exact permission checks', 'Unavailable-state UI', 'No automatic enforcement']
  },
  {
    title: 'Evaluator Execution — Unavailable',
    description: 'Worker execution, public evaluator packs, continuous monitoring, and automatic remediation are not provided in this alpha.',
    highlights: ['No worker runtime', 'No public evaluator packs', 'No live monitoring claim', 'No compliance determination']
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "FairMind v2.1.0-alpha.1",
  "description": "Internal, default-off evidence-control-plane foundation for versioned planning and human review.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "url": "https://fairmind.xyz/features"
};
---

<Layout title="Alpha Capability Boundary - FairMind" description="Review the implemented, default-off, planned, and unavailable boundaries for FairMind v2.1.0-alpha.1." structuredData={structuredData}>
  <section class="bg-white py-16 border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Alpha Capability Boundary</h1>
      <p class="text-lg text-gray-600">FairMind P0 organizes scoped assurance evidence for human review. It does not execute evaluators, certify systems, or enforce compliance.</p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {features.map((feature) => (
          <div class="bg-white p-8 border border-gray-200 hover:border-gray-300 transition-colors">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">{feature.title}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">{feature.description}</p>
            <div class="space-y-2">
              <h4 class="text-sm font-semibold text-gray-900 mb-3">Release boundary:</h4>
              <ul class="space-y-2">
                {feature.highlights.map((highlight) => (
                  <li class="flex items-start text-sm text-gray-600"><span class="mr-2">•</span><span>{highlight}</span></li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50 border-t border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Review Before You Rely</h2>
      <p class="text-lg text-gray-600 mb-8">Read the repository documentation and roadmap for release-scoped evidence.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://github.com/adhit-r/fairmind/tree/main/apps/docs/content/docs" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 bg-gray-900 text-white font-medium hover:bg-gray-800 transition-colors">Repository Docs</a>
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 text-gray-700 font-medium hover:border-gray-400 hover:bg-gray-50 transition-colors">Contact Us</a>
      </div>
    </div>
  </section>
</Layout>
