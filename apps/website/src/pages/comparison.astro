---
import { registryTotals } from '../lib/registry';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import '../styles/pages.css';

const rows = [
  { need: 'Run a fairness or safety test', evaluators: 'Yes, deeply', grc: 'No', fairmind: 'Yes for fairness, environmental, LLM judge. Imports the rest as Evidence Passports.' },
  { need: 'Map evidence to framework requirements', evaluators: 'No', grc: 'Yes, by questionnaire', fairmind: `Yes, by workflow run. ${registryTotals.frameworks} frameworks, standards and risk lists, ${registryTotals.crosswalk} crosswalk links, human-accepted mappings.` },
  { need: 'Human approval before anything changes', evaluators: 'Not in scope', grc: 'Sign-off on documents', fairmind: 'A gate step in every workflow. Deny by default; three change rounds escalate.' },
  { need: 'Tamper-evident record of what happened', evaluators: 'Logs', grc: 'Audit log', fairmind: 'Hash-chained run ledger, sealed by the file step, chain state shown on the run page.' },
  { need: 'A verdict your pipeline can read', evaluators: 'Thresholds in code', grc: 'No', fairmind: 'fairmind gate in the CLI and GitHub Actions. Measured failures never give a plain go.' },
  { need: 'Govern agents, tools, and MCP servers', evaluators: 'Some red-teaming', grc: 'Rarely', fairmind: 'Agentic bundle covering OWASP Agentic and MCP Top 10, AIUC-1, and ten agent-risk codes.' },
  { need: 'Certification', evaluators: 'No', grc: 'No', fairmind: 'No. Readiness and evidence only.' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fairmind.xyz/' },
    { '@type': 'ListItem', position: 2, name: 'Compare', item: 'https://fairmind.xyz/comparison/' },
  ],
};
---

<Layout
  title="FairMind vs AI evaluation tools and GRC suites | FairMind"
  description={`FairMind beside eval tools and GRC suites: it runs or imports test results and maps them to ${registryTotals.frameworks} frameworks, standards and risk lists.`}
  structuredData={structuredData}
>
  <div class="route-page">
    <PageHero
      signal="Compare"
      title="Evaluators test. GRC suites file."
      accent="FairMind decides, with people."
      description="Keep the evaluators you trust. Keep the GRC suite your auditors know. FairMind is the layer between them: the workflow that turns a test result into an approved, mapped, sealed record, and the gate that tells your pipeline what to do."
      proofs={[
        { label: 'Evidence in', value: 'Any evaluator', note: 'Run ours or ingest an Evidence Passport.' },
        { label: 'Decisions', value: 'Always a person', note: 'No evaluator changes compliance state on its own.' },
        { label: 'Evidence out', value: 'Versioned, sealed', note: 'Pinned framework versions, hash-chained runs, auditor mode.' },
      ]}
      primary={{ label: 'Request access', href: '/request-access/' }}
      secondary={{ label: 'See the platform', href: '/features/' }}
    />

    <section class="route-section" id="comparison-table" aria-labelledby="comparison-title">
      <header class="route-section-heading">
        <h2 id="comparison-title">Side by side.</h2>
        <p>Generalised across categories. Your tools may differ; the point is where the gaps usually are.</p>
      </header>
      <div class="route-table-wrap">
        <table class="route-table">
          <thead><tr><th>Need</th><th>Evaluation tools</th><th>GRC suites</th><th>FairMind</th></tr></thead>
          <tbody>
            {rows.map((r) => (<tr><td>{r.need}</td><td>{r.evaluators}</td><td>{r.grc}</td><td>{r.fairmind}</td></tr>))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="route-section route-section-dark" aria-labelledby="adapter-title">
      <div class="route-split">
        <div class="route-split-copy">
          <h2 id="adapter-title">Bring your own evaluator.</h2>
          <p>An Evidence Passport carries the subject, evaluator and metric versions, threshold, artifact digest, result, and limitations. Ingest one and it enters the same review, mapping, and gate as a test FairMind ran itself.</p>
          <p>Evaluators FairMind does not run are marked as such. Nothing is presented as measured unless it was.</p>
        </div>
        <div class="route-quote">
          <blockquote>The evaluator is not the governance decision.</blockquote>
          <p>A result becomes evidence when a person accepts what it supports, and the record keeps both.</p>
        </div>
      </div>
    </section>

    <section class="route-closing" aria-labelledby="comparison-closing-title">
      <h2 id="comparison-closing-title">Already running tests? Start by gating one.</h2>
      <div class="route-actions"><a class="button button-primary" href="/request-access/">Request access</a><a class="button" href="/demo/">Watch the walkthrough</a></div>
    </section>
  </div>
</Layout>
