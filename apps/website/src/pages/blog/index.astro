---
import { registryTotals } from '../../lib/registry';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/marketing/PageHero.astro';
import '../../styles/pages.css';

const notes = [
  {
    type: 'Research program',
    title: 'FairMind-E: environmental evidence for AI systems',
    description: 'A measurement and governance path for energy, carbon, water and uncertainty, with mitigation, exceptions, review and export. The path is validated; benchmarks are provisional until real hardware evidence is published.',
    state: 'Validated',
    href: '/roadmap/',
    link: 'Read the status',
  },
  {
    type: 'Method',
    title: 'A fairness check fails only when the disparity is not sampling noise',
    description: 'Why the fairness test reports bootstrap confidence intervals and a permutation test next to each metric, enforces a minimum group size of 30, and treats a measured failure as something attestations cannot outrank.',
    state: 'Shipped',
    href: '/features/#release-gate',
    link: 'See the gate',
  },
  {
    type: 'Catalogue',
    title: 'Agentic packs catalogue v2.3',
    description: `${registryTotals.frameworks} frameworks, ${registryTotals.requirements} requirements, ${registryTotals.commonControls} common controls and ${registryTotals.crosswalk} crosswalk links; 21 packs, 90 workflows and 109 evaluations in four pillars. How the crosswalk lets one run count toward every requirement it maps to, and where the gaps still are.`,
    state: 'Published',
    href: '/frameworks/',
    link: 'Browse the frameworks',
  },
  {
    type: 'Design note',
    title: 'Twenty controls on our own agent',
    description: 'Per-step scoped identity, a deterministic tool allowlist, collected content treated as data, mandatory citations, pinned models and prompts with golden-set evaluations, a hash-chained trace, cost caps and a kill switch. Mapped to AIUC-1, OWASP Agentic, NIST AI RMF and SG MGF.',
    state: 'Principle',
    href: '/about/',
    link: 'Read the principles',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fairmind.xyz/' },
    { '@type': 'ListItem', position: 2, name: 'Research', item: 'https://fairmind.xyz/blog/' },
  ],
};
---

<Layout
  title="FairMind research and design notes | Agentic AI governance"
  description="Research programs, methods and design notes behind FairMind: environmental evidence (FairMind-E), the statistics behind the fairness gate, the agentic packs catalogue, and the controls on FairMind's own agent."
  structuredData={structuredData}
>
  <div class="route-page">
    <PageHero
      signal="Research"
      title="Methods, with their"
      accent="limitations attached."
      description="The working record behind the product. Each note says what kind of evidence exists and what is still unproven."
      proofs={[
        { label: 'Standard', value: 'Claim follows evidence', note: 'A negative result is published as such.' },
        { label: 'Venues', value: '2026 and 2027', note: 'LLM4Code at ICSE, AISec at CCS, MSR, ASE.' },
        { label: 'Preprints', value: 'arXiv, SSRN, Zenodo', note: 'Open by default.' },
      ]}
      primary={{ label: 'Contact the team', href: '/contact/' }}
    />

    <section class="route-section" id="research-notes" aria-labelledby="notes-title">
      <header class="route-section-heading"><h2 id="notes-title">Current programs and notes.</h2></header>
      <div class="route-ledger">
        {notes.map((note) => (
          <article class="route-ledger-row">
            <span>{note.type}<br /><span class="route-state">{note.state}</span></span>
            <h3>{note.title}</h3>
            <p>{note.description} <a href={note.href}>{note.link}</a></p>
          </article>
        ))}
      </div>
    </section>

    <section class="route-closing" aria-labelledby="research-closing-title">
      <h2 id="research-closing-title">Collaborate on a measurement.</h2>
      <p>If you run AI systems in production and can share anonymised evaluation data, we would like to compare notes.</p>
      <div class="route-actions"><a class="button button-primary" href="/contact/">Contact FairMind</a><a class="button" href="https://github.com/adhit-r/fairmind">GitHub</a></div>
    </section>
  </div>
</Layout>
