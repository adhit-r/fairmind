---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/marketing/PageHero.astro';
import '../../styles/pages.css';

const notes = [
  {
    type: 'Research program',
    title: 'FairMind-E environmental evidence',
    description: 'A measurement and governance path for energy, carbon, water, uncertainty, mitigation, exceptions, review, and export. The path is validated; real hardware evidence is still required for publication claims.',
    state: 'Measurement path validated',
    href: '/roadmap',
    link: 'Read the bounded status',
  },
  {
    type: 'Evidence profile',
    title: 'AI BOM fairness evidence',
    description: 'A reviewer-facing transformation of supplied inventory, bias, remediation, evidence, and unknown metadata. It is a metadata profile, not an independent evaluation.',
    state: 'metadata_only',
    href: 'https://github.com/adhit-r/fairmind',
    link: 'Inspect the source',
  },
  {
    type: 'Product contract',
    title: 'Evidence Passport',
    description: 'The target portable unit for subject identity, evaluator and metric versions, threshold, raw artifact integrity, result, limitation, reviewer decision, remediation, and superseding rerun.',
    state: 'Recovery target',
    href: '/features',
    link: 'Inspect the contract',
  },
  {
    type: 'Assurance architecture',
    title: 'Human-reviewed framework reuse',
    description: 'Accepted evidence may support several versioned frameworks. A technical result never accepts its own control mapping or determines conformity.',
    state: 'Design principle',
    href: '/comparison',
    link: 'Compare the roles',
  },
];
---

<Layout
  title="FairMind research and field notes | Methods with limitations attached"
  description="Research programs, evidence contracts, architecture notes, and bounded findings from the FairMind AI assurance workbench."
>
  <div class="route-page">
    <PageHero
      signal="Research and field notes"
      title="Methods, artifacts,"
      accent="limitations attached."
      description="This is the working record around FairMind’s research and product thesis—not a pile of generic responsible-AI links. Each item states what kind of evidence exists and what remains unproven."
      proofs={[
        { label: 'Research rule', value: 'Observed is not fixture-only', note: 'Smoke runs and ablations prove paths, not real-world claims.' },
        { label: 'Product rule', value: 'Metadata is not measurement', note: 'A useful transformation keeps the limitation visible.' },
        { label: 'Governance rule', value: 'Evidence is not conformity', note: 'Framework relationships require accountable human review.' },
      ]}
      primary={{ label: 'Read the current notes', href: '#research-notes' }}
      secondary={{ label: 'Inspect the source', href: 'https://github.com/adhit-r/fairmind' }}
      dark={true}
    />

    <section class="route-section" id="research-notes" aria-labelledby="notes-title">
      <header class="route-section-heading"><h2 id="notes-title">Current programs and contracts.</h2><p>These are bounded descriptions of active work. They are not publication, certification, or production-readiness claims.</p></header>
      <div class="route-ledger">
        {notes.map((note) => (
          <article class="route-ledger-row">
            <span>{note.type}<br /><span class="route-state">{note.state}</span></span>
            <h3>{note.title}</h3>
            <p>{note.description}<br /><a href={note.href}>{note.link}</a></p>
          </article>
        ))}
      </div>
    </section>

    <section class="route-section route-section-orange" aria-labelledby="research-standard-title">
      <div class="route-split">
        <div class="route-split-copy"><h2 id="research-standard-title">A negative result is still useful evidence.</h2><p>FairMind research should preserve missing measurements, failed hypotheses, incompatible comparisons, provider dependencies, and insufficient data. Deleting those boundaries makes the result less scientific and the product less trustworthy.</p></div>
        <div class="route-quote"><blockquote>Claim strength follows evidence strength.</blockquote></div>
      </div>
    </section>

    <section class="route-closing" aria-labelledby="research-closing-title">
      <div><p>Have an evaluator, dataset, or assurance question?</p><h2 id="research-closing-title">Collaborate on a bounded evidence path.</h2></div>
      <div class="route-actions"><a class="button button-primary" href="/contact">Contact FairMind</a><a class="button button-secondary" href="/roadmap">Read the recovery roadmap</a></div>
    </section>
  </div>
</Layout>
