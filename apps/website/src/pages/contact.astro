---
import Layout from '../layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Fairmind",
  "description": "Ask about internal-alpha access, capability boundaries, source documentation, or research collaboration.",
  "url": "https://fairmind.xyz/contact",
  "mainEntity": {
    "@type": "Organization",
    "name": "Fairmind",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "support@fairmind.xyz",
      "availableLanguage": "English"
    }
  }
};
---

<Layout 
  title="Contact FairMind | Alpha Access and Capability Questions"
  description="Ask the FairMind team about internal-alpha access, capability boundaries, source documentation, or research collaboration."
  structuredData={structuredData}
>
  <div class="min-h-screen bg-black">
    <!-- Header -->
    <div class="bg-black border-b-2 border-yellow-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-black text-yellow-400 mb-6">
            GET IN TOUCH
          </h1>
          <p class="text-xl text-yellow-400 max-w-3xl mx-auto font-bold">
            ASK ABOUT INTERNAL-ALPHA ACCESS, CAPABILITY BOUNDARIES, SOURCE DOCUMENTATION, OR RESEARCH COLLABORATION.
          </p>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        
        <!-- Contact Form -->
        <div class="bg-black p-8 rounded-none border-2 border-yellow-400 shadow-[6px_6px_0px_0px_rgba(255,255,0,1)]">
          <h2 class="text-2xl font-black text-yellow-400 mb-6">SEND US A MESSAGE</h2>
          
          <form id="contact-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-black text-yellow-400 mb-2">
                  FIRST NAME *
                </label>
                <input
                  type="text"
                  id="first-name"
                  name="firstName"
                  required
                  class="w-full px-4 py-3 border-2 border-yellow-400 bg-black text-yellow-400 rounded-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent placeholder-yellow-400/50"
                  placeholder="JOHN"
                />
              </div>
              
              <div>
                <label for="last-name" class="block text-sm font-black text-yellow-400 mb-2">
                  LAST NAME *
                </label>
                <input
                  type="text"
                  id="last-name"
                  name="lastName"
                  required
                  class="w-full px-4 py-3 border-2 border-yellow-400 bg-black text-yellow-400 rounded-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent placeholder-yellow-400/50"
                  placeholder="DOE"
                />
              </div>
            </div>
            
            <div>
              <label for="email" class="block text-sm font-black text-yellow-400 mb-2">
                EMAIL ADDRESS *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border-2 border-yellow-400 bg-black text-yellow-400 rounded-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent placeholder-yellow-400/50"
                placeholder="JOHN@COMPANY.COM"
              />
            </div>
            
            <div>
              <label for="company" class="block text-sm font-black text-yellow-400 mb-2">
                COMPANY
              </label>
              <input
                type="text"
                id="company"
                name="company"
                class="w-full px-4 py-3 border-2 border-yellow-400 bg-black text-yellow-400 rounded-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent placeholder-yellow-400/50"
                placeholder="YOUR COMPANY"
              />
            </div>
            
            <div>
              <label for="subject" class="block text-sm font-black text-yellow-400 mb-2">
                SUBJECT *
              </label>
              <select
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 border-2 border-yellow-400 bg-black text-yellow-400 rounded-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent"
              >
                <option value="" class="bg-black text-yellow-400">SELECT A SUBJECT</option>
                <option value="general" class="bg-black text-yellow-400">GENERAL INQUIRY</option>
                <option value="alpha-access" class="bg-black text-yellow-400">ALPHA ACCESS</option>
                <option value="capability" class="bg-black text-yellow-400">CAPABILITY QUESTION</option>
                <option value="research" class="bg-black text-yellow-400">RESEARCH COLLABORATION</option>
                <option value="docs" class="bg-black text-yellow-400">SOURCE OR DOCUMENTATION</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-black text-yellow-400 mb-2">
                MESSAGE *
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full px-4 py-3 border-2 border-yellow-400 bg-black text-yellow-400 rounded-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent placeholder-yellow-400/50"
                placeholder="TELL US WHICH ALPHA WORKFLOW OR CAPABILITY BOUNDARY YOU WANT TO DISCUSS..."
              ></textarea>
            </div>
            
            <button
              type="submit"
              class="w-full bg-yellow-400 text-black font-black py-4 px-6 rounded-none border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transform hover:-translate-y-2 transition-all"
            >
              SEND MESSAGE
            </button>
          </form>
        </div>
        
        <!-- Contact Information -->
        <div class="space-y-8">
          <!-- Direct Contact -->
          <div class="bg-black p-8 rounded-none border-2 border-yellow-400 shadow-[6px_6px_0px_0px_rgba(255,255,0,1)]">
            <h3 class="text-2xl font-black text-yellow-400 mb-6">DIRECT CONTACT</h3>
            <div class="space-y-4">
              <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-yellow-400 rounded-none border-2 border-black flex items-center justify-center shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
                  <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div>
                  <p class="text-yellow-400 font-bold">EMAIL</p>
                  <a href="mailto:support@fairmind.xyz" class="text-yellow-400 font-black hover:text-yellow-300 transition-colors">
                    SUPPORT@FAIRMIND.XYZ
                  </a>
                </div>
              </div>
              
              <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-yellow-400 rounded-none border-2 border-black flex items-center justify-center shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
                  <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div>
                  <p class="text-yellow-400 font-bold">WEBSITE</p>
                  <a href="https://fairmind.xyz" class="text-yellow-400 font-black hover:text-yellow-300 transition-colors">
                    FAIRMIND.XYZ
                  </a>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Response Time -->
          <div class="bg-black p-8 rounded-none border-2 border-yellow-400 shadow-[6px_6px_0px_0px_rgba(255,255,0,1)]">
            <h3 class="text-2xl font-black text-yellow-400 mb-6">CONTACT STATUS</h3>
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-yellow-400 font-bold">GENERAL INQUIRIES</span>
                <span class="text-yellow-400 font-black">NO PUBLISHED SLA</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-yellow-400 font-bold">ALPHA ACCESS</span>
                <span class="text-yellow-400 font-black">BY ARRANGEMENT</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-yellow-400 font-bold">RESEARCH REQUESTS</span>
                <span class="text-yellow-400 font-black">REVIEWED INDIVIDUALLY</span>
              </div>
            </div>
          </div>
          
          <!-- Office Hours -->
          <div class="bg-black p-8 rounded-none border-2 border-yellow-400 shadow-[6px_6px_0px_0px_rgba(255,255,0,1)]">
            <h3 class="text-2xl font-black text-yellow-400 mb-6">COORDINATION</h3>
            <div class="space-y-2">
              <div class="flex justify-between">
                <span class="text-yellow-400 font-bold">CONTACT</span>
                <span class="text-yellow-400 font-black">BY EMAIL</span>
              </div>
              <div class="flex justify-between">
                <span class="text-yellow-400 font-bold">SUPPORT</span>
                <span class="text-yellow-400 font-black">NO EMERGENCY SLA</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- FAQ Section -->
    <section class="py-20 bg-black border-t-2 border-yellow-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-4xl font-black text-yellow-400 text-center mb-12">FREQUENTLY ASKED QUESTIONS</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-black p-6 rounded-none border-2 border-yellow-400 shadow-[4px_4px_0px_0px_rgba(255,255,0,1)]">
            <h3 class="text-xl font-black text-yellow-400 mb-3">HOW CAN I EVALUATE FAIRMIND?</h3>
            <p class="text-yellow-400 font-bold">REVIEW THE REPOSITORY AND ROADMAP. RUNTIME ACCESS, IF APPROPRIATE, IS ARRANGED AND VALIDATED INDIVIDUALLY.</p>
          </div>
          
          <div class="bg-black p-6 rounded-none border-2 border-yellow-400 shadow-[4px_4px_0px_0px_rgba(255,255,0,1)]">
            <h3 class="text-xl font-black text-yellow-400 mb-3">IS THIS PRODUCTION-READY?</h3>
            <p class="text-yellow-400 font-bold">NO. V2.1.0-ALPHA.1 IS AN INTERNAL, DEFAULT-OFF CONTROL-PLANE FOUNDATION.</p>
          </div>
          
          <div class="bg-black p-6 rounded-none border-2 border-yellow-400 shadow-[4px_4px_0px_0px_rgba(255,255,0,1)]">
            <h3 class="text-xl font-black text-yellow-400 mb-3">DOES FAIRMIND CERTIFY COMPLIANCE?</h3>
            <p class="text-yellow-400 font-bold">NO. EVIDENCE MAY SUPPORT HUMAN REVIEW, BUT FAIRMIND DOES NOT CERTIFY SYSTEMS OR DETERMINE LEGAL COMPLIANCE.</p>
          </div>
          
          <div class="bg-black p-6 rounded-none border-2 border-yellow-400 shadow-[4px_4px_0px_0px_rgba(255,255,0,1)]">
            <h3 class="text-xl font-black text-yellow-400 mb-3">WHICH INTEGRATIONS ARE AVAILABLE?</h3>
            <p class="text-yellow-400 font-bold">DO NOT ASSUME GENERAL INTEGRATION SUPPORT. EACH CAPABILITY AND ENVIRONMENT MUST BE VERIFIED FOR THE TARGET RELEASE.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  document.getElementById('contact-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    alert('THIS STATIC FORM IS NOT CONNECTED. PLEASE EMAIL SUPPORT@FAIRMIND.XYZ.');
  });
</script>
