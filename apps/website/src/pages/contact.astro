---
import Layout from '../layouts/Layout.astro';

const repositoryUrl = 'https://github.com/adhit-r/fairmind';
const issueUrl = `${repositoryUrl}/issues/new`;
const sourceDocsUrl = `${repositoryUrl}/tree/main/apps/docs/content/docs`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'FairMind project channels',
  description: 'Verified public channels for FairMind source, documentation, and project questions.',
  url: 'https://fairmind.xyz/contact',
};
---

<Layout
  title="FairMind Project Channels | Source, Docs, and Questions"
  description="Use FairMind's verified GitHub channels for source, documentation, and bounded project questions."
  structuredData={structuredData}
>
  <div class="min-h-screen bg-black text-yellow-400">
    <header class="border-b-2 border-yellow-400">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
        <h1 class="max-w-4xl text-4xl font-black leading-tight md:text-6xl">
          PROJECT CHANNELS
        </h1>
        <p class="mt-6 max-w-3xl text-lg font-bold leading-relaxed md:text-xl">
          FairMind does not operate a verified website contact form or publish a support-response SLA.
          Use the public repository for source, documentation, and project questions.
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <section aria-labelledby="choose-channel" class="border-2 border-yellow-400 p-6 shadow-[6px_6px_0px_0px_rgba(250,204,21,1)] md:p-10">
        <h2 id="choose-channel" class="text-2xl font-black md:text-3xl">CHOOSE THE RIGHT CHANNEL</h2>

        <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_auto_1fr] lg:items-stretch">
          <div class="flex min-w-0 flex-col">
            <h3 class="text-xl font-black">SOURCE AND DOCUMENTATION</h3>
            <p class="mt-3 max-w-prose font-bold leading-relaxed">
              Review the P0 release boundary, operator guidance, API integration notes, and EU AI Act
              evidence crosswalk in the repository.
            </p>
            <a
              href={sourceDocsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex min-h-11 w-fit items-center border-2 border-yellow-400 px-5 py-3 font-black text-yellow-400 transition-colors hover:bg-yellow-400 hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-yellow-400"
            >
              READ SOURCE DOCS
            </a>
          </div>

          <div class="hidden w-px bg-yellow-400 lg:block" aria-hidden="true"></div>

          <div class="flex min-w-0 flex-col border-t-2 border-yellow-400 pt-8 lg:border-0 lg:pt-0">
            <h3 class="text-xl font-black">PROJECT QUESTIONS</h3>
            <p class="mt-3 max-w-prose font-bold leading-relaxed">
              Open a GitHub issue for a reproducible bug, documentation gap, or bounded capability
              question. Public issues are not a private support channel.
            </p>
            <a
              href={issueUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex min-h-11 w-fit items-center bg-yellow-400 px-5 py-3 font-black text-black outline outline-2 outline-black transition-transform hover:-translate-y-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-yellow-400 motion-reduce:transform-none"
            >
              OPEN A GITHUB ISSUE
            </a>
          </div>
        </div>
      </section>

      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        <section aria-labelledby="safe-reporting" class="border-t-2 border-yellow-400 pt-6">
          <h2 id="safe-reporting" class="text-2xl font-black">BEFORE YOU POST</h2>
          <ul class="mt-5 space-y-4 font-bold leading-relaxed">
            <li>Do not include secrets, personal data, customer evidence, access tokens, or private system details.</li>
            <li>Describe the release, route, expected behavior, observed behavior, and a minimal reproduction.</li>
            <li>For security-sensitive reports, use the repository security policy instead of a public issue.</li>
          </ul>
          <a
            href={`${repositoryUrl}/security/policy`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex min-h-11 items-center border-b-2 border-yellow-400 font-black hover:text-yellow-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-yellow-400"
          >
            READ THE SECURITY POLICY
          </a>
        </section>

        <section aria-labelledby="channel-status" class="border-t-2 border-yellow-400 pt-6">
          <h2 id="channel-status" class="text-2xl font-black">CHANNEL STATUS</h2>
          <dl class="mt-5 divide-y divide-yellow-400 border-y-2 border-yellow-400 font-bold">
            <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-4">
              <dt>PUBLIC SOURCE</dt>
              <dd class="text-yellow-200">GitHub repository</dd>
            </div>
            <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-4">
              <dt>DOCUMENTATION</dt>
              <dd class="text-yellow-200">Repository source; hosted domain not yet verified</dd>
            </div>
            <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-4">
              <dt>RUNTIME ACCESS</dt>
              <dd class="text-yellow-200">Not self-service; arranged only for approved environments</dd>
            </div>
            <div class="grid gap-1 py-4 sm:grid-cols-[11rem_1fr] sm:gap-4">
              <dt>RESPONSE TIME</dt>
              <dd class="text-yellow-200">No published SLA</dd>
            </div>
          </dl>
        </section>
      </div>

      <section aria-labelledby="release-boundary" class="mt-12 bg-yellow-400 p-6 text-black md:p-8">
        <h2 id="release-boundary" class="text-2xl font-black !text-black">P0 ALPHA BOUNDARY</h2>
        <p class="mt-4 max-w-4xl font-black leading-relaxed !text-black">
          FairMind v2.1.0-alpha.1 is a default-off assurance control-plane foundation. It does not
          certify compliance, provide a general evaluation engine, or promise production support.
        </p>
      </section>
    </div>
  </div>
</Layout>
