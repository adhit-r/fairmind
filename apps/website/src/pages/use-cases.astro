---
import Layout from '../layouts/Layout.astro';

const contexts = [
  {
    name: 'FINANCIAL SERVICES',
    example: 'Credit-decision evidence review',
    review: ['Bind the exact decision system and target version', 'Record imported evidence provenance', 'Expose freshness and limitation state', 'Keep the human governance decision separate']
  },
  {
    name: 'HEALTHCARE',
    example: 'Clinical decision-support evidence review',
    review: ['Define the intended-use boundary', 'Record suite and evidence identities', 'Surface unresolved trust state', 'Require domain-qualified human review']
  },
  {
    name: 'EMPLOYMENT',
    example: 'Hiring-system evidence review',
    review: ['Scope the workflow and affected population', 'Preserve source and signer state', 'Record reviewer findings and limitations', 'Avoid automatic fairness conclusions']
  },
  {
    name: 'PUBLIC SECTOR',
    example: 'Benefits-decision evidence review',
    review: ['Bind the decision context', 'Keep evidence and governance state distinct', 'Expose stale or unverified evidence', 'Retain accountable human decision-making']
  }
];

const questions = [
  'Is every claim bound to the exact system, target, suite, and version?',
  'Can a reviewer distinguish source evidence from inferred trust state?',
  'Are stale, revoked, conflicting, or unverified states explicit?',
  'Is the final decision attributable to a human governance authority?'
];
---

<Layout
  title="Illustrative Review Contexts - FairMind"
  description="Illustrative contexts for FairMind's internal-alpha evidence-control-plane foundation. These are not deployed customer outcomes."
>
  <section class="bg-black text-yellow-400 py-24 border-b-2 border-yellow-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-black mb-6">ILLUSTRATIVE REVIEW CONTEXTS</h1>
      <p class="text-xl md:text-2xl max-w-4xl mx-auto font-bold">
        EXAMPLES OF WHERE SCOPED EVIDENCE AND HUMAN REVIEW MAY HELP. THESE ARE NOT DEPLOYED CUSTOMER CLAIMS, MEASURED OUTCOMES, OR COMPLIANCE DETERMINATIONS.
      </p>
    </div>
  </section>

  <section class="py-20 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {contexts.map((context) => (
          <article class="bg-black p-8 border-2 border-yellow-400 shadow-[6px_6px_0px_0px_rgba(255,255,0,1)]">
            <h2 class="text-2xl font-black text-yellow-400 mb-3">{context.name}</h2>
            <p class="text-lg text-yellow-400 font-bold mb-6">{context.example}</p>
            <h3 class="text-sm font-black text-yellow-400 mb-3">REVIEW PATTERN</h3>
            <ul class="space-y-3">
              {context.review.map((item) => (
                <li class="flex items-start space-x-3">
                  <span class="text-yellow-400 font-black">—</span>
                  <span class="text-yellow-400 font-bold">{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-black border-t-2 border-yellow-400">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-black text-yellow-400 mb-8 text-center">EVIDENCE QUALITY QUESTIONS</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {questions.map((question) => (
          <div class="bg-black p-6 border-2 border-yellow-400 shadow-[4px_4px_0px_0px_rgba(255,255,0,1)]">
            <p class="text-yellow-400 font-bold">{question}</p>
          </div>
        ))}
      </div>
      <p class="text-yellow-400 font-bold text-center mt-10">
        THE CURRENT P0 FOUNDATION DOES NOT RUN EVALUATORS, MONITOR PRODUCTION SYSTEMS, REMEDIATE MODELS, OR CERTIFY COMPLIANCE.
      </p>
    </div>
  </section>

  <section class="py-20 bg-black border-t-2 border-yellow-400">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-black text-yellow-400 mb-6">DISCUSS A BOUNDED REVIEW CONTEXT</h2>
      <p class="text-xl text-yellow-400 font-bold mb-8">ACCESS AND CAPABILITY COVERAGE ARE CONFIRMED INDIVIDUALLY.</p>
      <a href="/request-access" class="inline-flex items-center px-8 py-4 bg-yellow-400 text-black font-black border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all">
        REQUEST ALPHA ACCESS
      </a>
    </div>
  </section>
</Layout>
