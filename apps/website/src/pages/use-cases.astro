---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import '../styles/pages.css';

const cases = [
  {
    title: 'Engineering · bind a test to the right subject',
    problem: 'Evaluator output exists, but the model version, dataset or prompt scope, threshold, and raw artifact are scattered across tools.',
    result: ['Create the AI-system boundary before interpreting the result.', 'Record evaluator and metric versions plus the pre-registered threshold.', 'Preserve the raw artifact, limitation, and capability state.'],
  },
  {
    title: 'Review · decide whether evidence supports a control',
    problem: 'A technical pass is being treated like an accepted governance mapping without independent review or rationale.',
    result: ['Route candidate mappings to an accountable reviewer.', 'Accept, reject, or narrow the mapping with recorded rationale.', 'Reuse accepted evidence across versioned frameworks without inferring conformity.'],
  },
  {
    title: 'Safety · retain findings through remediation and retest',
    problem: 'A clean rerun replaces the failed result, leaving no durable history of what happened or why the change was accepted.',
    result: ['Create a finding and risk from the bounded result.', 'Assign remediation, owner, exception, and due state.', 'Link the clean retest to the failure instead of overwriting it.'],
  },
  {
    title: 'Assurance · compile a package for a real decision',
    problem: 'Evidence is assembled manually at review time, with unclear freshness, framework version, exclusions, and unresolved blockers.',
    result: ['Pin framework and catalog versions.', 'Compile the evidence index at a stated cutoff.', 'Expose limitations, unresolved findings, policies, approvals, and missing evidence.'],
  },
  {
    title: 'Research · keep methods and claim limits attached',
    problem: 'A smoke run, fixture, or metadata transformation is easy to overstate after it leaves the experiment notebook.',
    result: ['Preserve method, environment, measurement status, and uncertainty.', 'Label fixture-only and metadata-only outputs precisely.', 'Require observed evidence before promoting a research claim.'],
  },
];
---

<Layout
  title="FairMind use cases | From evaluator output to accountable decision"
  description="Use FairMind to bind tests to AI systems, review evidence mappings, retain findings and retests, and compile decision-ready assurance packages."
>
  <div class="route-page">
    <PageHero
      signal="Use cases follow responsibility, not industry theater"
      title="Different teams."
      accent="One evidence record."
      description="Engineering produces results. Reviewers decide what those results support. Assurance owners carry findings, limits, and approvals into the decision. FairMind keeps those handoffs in one system-scoped chain."
      proofs={[
        { label: 'Engineering asks', value: 'What exactly did we test?', note: 'Subject, version, scope, evaluator, threshold, artifact.' },
        { label: 'Review asks', value: 'What does this evidence support?', note: 'Candidate mapping, decision, rationale, limitations.' },
        { label: 'Assurance asks', value: 'What remains unresolved?', note: 'Findings, remediation, exceptions, retests, approvals.' },
      ]}
      primary={{ label: 'Inspect the handoffs', href: '#use-case-ledger' }}
      secondary={{ label: 'See the product workflow', href: '/features' }}
      dark={true}
    />

    <section class="route-section" id="use-case-ledger" aria-labelledby="use-case-title">
      <header class="route-section-heading">
        <h2 id="use-case-title">The same result has different jobs to do.</h2>
        <p>Open a workflow to see the broken handoff FairMind addresses and the evidence the receiving team should get.</p>
      </header>
      <div class="route-disclosure">
        {cases.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.title}</summary>
            <div>
              <p><strong>Broken handoff:</strong><br />{item.problem}</p>
              <ul>{item.result.map((result) => <li>{result}</li>)}</ul>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="route-section route-section-orange" aria-labelledby="not-fit-title">
      <div class="route-split">
        <div class="route-split-copy">
          <h2 id="not-fit-title">What FairMind is not for.</h2>
          <p>It is not a replacement for every evaluator, not a legal conformity engine, not an automated approver, and not a place where missing data quietly becomes “not biased.”</p>
        </div>
        <div class="route-checklist">
          <div><span>No</span><strong>Universal trust score without scope and denominator</strong></div>
          <div><span>No</span><strong>Automatic control acceptance from a technical test</strong></div>
          <div><span>No</span><strong>Certification or legal advice</strong></div>
          <div><span>No</span><strong>Erased failures after a clean rerun</strong></div>
        </div>
      </div>
    </section>

    <section class="route-closing" aria-labelledby="cases-closing-title">
      <div><p>Choose one broken handoff</p><h2 id="cases-closing-title">Turn it into a defensible evidence path.</h2></div>
      <div class="route-actions">
        <a class="button button-primary" href="/request-access">Describe your use case</a>
        <a class="button button-secondary" href="/roadmap">Check current boundaries</a>
      </div>
    </section>
  </div>
</Layout>
