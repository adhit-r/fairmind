---
import { registryTotals } from '../lib/registry';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import '../styles/pages.css';

const principles = [
  { strong: 'Deny by default.', text: 'If an approver is unreachable or no policy covers an action, nothing is recorded or changed.' },
  { strong: 'Capability truth.', text: 'Every evaluator and every workflow step says what it does today: validated, external provider, metadata only, unavailable, or manual.' },
  { strong: 'Evidence over claims.', text: 'A measured failure outranks an attestation. Readiness is never certification.' },
  { strong: 'The agent is governed too.', text: 'Scoped identity per step, a tool allowlist prompts cannot widen, a hash-chained trace, a kill switch per run.' },
  { strong: 'Gaps shown, not hidden.', text: 'Framework journeys list every requirement, including the ones nothing covers yet.' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fairmind.xyz/' },
      { '@type': 'ListItem', position: 2, name: 'About', item: 'https://fairmind.xyz/about/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About FairMind',
    url: 'https://fairmind.xyz/about/',
    about: { '@id': 'https://fairmind.xyz/#organization' },
  },
];
---

<Layout
  title="About FairMind | Agentic AI governance by Axonome"
  description="FairMind is built by Axonome. It turns AI governance into agent workflows that stop for human decisions, and keeps the evidence on a tamper-evident ledger. Open source."
  structuredData={structuredData}
>
  <div class="route-page">
    <PageHero
      signal="About"
      title="Governance work should be done by agents."
      accent="Governance decisions should not."
      description="FairMind started as a bias-detection toolkit and became a governance platform when we noticed where the real cost was: not in running a test, but in everything around it. Collecting the evidence, mapping it to fifty frameworks, getting a person to look, and proving later that they did."
      proofs={[
        { label: 'Built by', value: 'Axonome', note: 'A small team working with ML engineers, security leads and compliance leads.' },
        { label: 'Code', value: 'Open source', note: 'MIT licence. The product you evaluate is the repository you can read.' },
        { label: 'Research', value: 'FairMind-E', note: 'Environmental evidence for AI systems, with limitations attached.' },
      ]}
      primary={{ label: 'Contact us', href: '/contact/' }}
      secondary={{ label: 'Research notes', href: '/research/' }}
    />

    <section class="route-section" id="principles" aria-labelledby="principles-title">
      <div class="route-split">
        <div class="route-split-copy">
          <h2 id="principles-title">Five rules we don't trade away.</h2>
          <p>They are written into the workflow validator, the gate, and the ledger, not only into this page.</p>
        </div>
        <ul class="route-checklist">{principles.map((p) => <li><strong>{p.strong}</strong>{p.text}</li>)}</ul>
      </div>
    </section>

    <section class="route-section route-section-dark" aria-labelledby="why-title">
      <div class="route-split">
        <div class="route-split-copy">
          <h2 id="why-title">Why evaluations and workflows, not a checklist.</h2>
          <p>A checklist tells you what a framework asks. It cannot tell you whether the agent blocked an out-of-scope action, or whether the impact ratio cleared 0.8. So the catalogue is built from 109 evaluations, each with a metric and a declared threshold, and 90 workflows that produce the evidence a requirement actually needs. {registryTotals.commonControls} common controls connect them to {registryTotals.requirements} requirements across {registryTotals.frameworks} frameworks, so one run counts everywhere it applies.</p>
          <p>The registry covers {registryTotals.frameworks} frameworks because that is how many our design partners are actually asked about.</p>
        </div>
        <div class="route-quote">
          <blockquote>Let the agents do the paperwork. Keep the decisions.</blockquote>
          <p>The sentence we test every feature against.</p>
        </div>
      </div>
    </section>

    <section class="route-closing" aria-labelledby="about-closing-title">
      <h2 id="about-closing-title">Work with us.</h2>
      <p>Design partners, contributors, and researchers are all welcome. Start with the repository or a conversation.</p>
      <div class="route-actions">
        <a class="button button-primary" href="/request-access/">Request access</a>
        <a class="button" href="https://github.com/adhit-r/fairmind">GitHub</a>
      </div>
    </section>
  </div>
</Layout>
