---
import Layout from '../layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Fairmind",
  "description": "Internal-alpha evidence-control-plane foundation for scoped AI assurance evidence and human review.",
  "url": "https://fairmind.xyz",
  "logo": "https://fairmind.xyz/logo.png",
  "foundingDate": "2024",
  "sameAs": ["https://github.com/adhit-r/fairmind"]
};
---

<Layout 
  title="About FairMind | Evidence Before Assurance"
  description="Learn why FairMind is building a default-off evidence-control-plane foundation for scoped evidence and human review."
  structuredData={structuredData}
>
  <div class="min-h-screen bg-black">
    <!-- Hero Section -->
    <section class="bg-black text-yellow-400 py-24 border-b-2 border-yellow-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-5xl md:text-6xl font-black mb-6">
          EVIDENCE BEFORE ASSURANCE
        </h1>
        <p class="text-xl md:text-2xl text-yellow-400 max-w-4xl mx-auto font-bold">
          FAIRMIND V2.1.0-ALPHA.1 IS AN INTERNAL, DEFAULT-OFF FOUNDATION FOR VERSIONED ASSURANCE PLANNING, SCOPED EVIDENCE, AND HUMAN REVIEW.
        </p>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="py-20 bg-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl font-black text-yellow-400 mb-6">MISSION</h2>
            <p class="text-lg text-yellow-400 mb-6 font-bold">
              WE BELIEVE AI ASSURANCE SHOULD BEGIN WITH PRECISE SCOPE, REVIEWABLE EVIDENCE, AND EXPLICIT LIMITATIONS.
            </p>
            <p class="text-lg text-yellow-400 mb-6 font-bold">
              THE CURRENT ALPHA BUILDS THAT CONTROL-PLANE FOUNDATION. IT DOES NOT EXECUTE EVALUATORS, CERTIFY SYSTEMS, OR GUARANTEE COMPLIANCE.
            </p>
            <div class="grid grid-cols-2 gap-6 mt-8">
              <div class="text-center">
                <div class="text-3xl font-black text-yellow-400 mb-2 border-2 border-yellow-400 bg-black px-4 py-2 shadow-[4px_4px_0px_0px_rgba(255,255,0,1)]">2.1.0</div>
                <div class="text-yellow-400 font-bold">ALPHA</div>
              </div>
              <div class="text-center">
                <div class="text-3xl font-black text-yellow-400 mb-2 border-2 border-yellow-400 bg-black px-4 py-2 shadow-[4px_4px_0px_0px_rgba(255,255,0,1)]">P0</div>
                <div class="text-yellow-400 font-bold">CONTROL PLANE</div>
              </div>
            </div>
          </div>
          <div class="bg-black p-8 rounded-none border-2 border-yellow-400 shadow-[6px_6px_0px_0px_rgba(255,255,0,1)]">
            <h3 class="text-2xl font-black text-yellow-400 mb-4">VALUES</h3>
            <div class="space-y-4">
              <div class="flex items-start space-x-3">
                <div class="w-6 h-6 bg-yellow-400 rounded-none border-2 border-black flex items-center justify-center flex-shrink-0 mt-1 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                  <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="font-black text-yellow-400">TRANSPARENCY</h4>
                  <p class="text-yellow-400 font-bold">DISTINGUISH OBSERVED EVIDENCE, INFERRED TRUST STATE, AND HUMAN DECISIONS.</p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-6 h-6 bg-yellow-400 rounded-none border-2 border-black flex items-center justify-center flex-shrink-0 mt-1 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                  <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="font-black text-yellow-400">FAIRNESS</h4>
                  <p class="text-yellow-400 font-bold">MAKE NO FAIRNESS CLAIM WITHOUT SCOPED, REVIEWED, AND RELEASE-VALIDATED EVIDENCE.</p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <div class="w-6 h-6 bg-yellow-400 rounded-none border-2 border-black flex items-center justify-center flex-shrink-0 mt-1 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                  <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="font-black text-yellow-400">ACCOUNTABILITY</h4>
                  <p class="text-yellow-400 font-bold">PRESERVE EXACT SCOPE, PROVENANCE, LIMITATIONS, AND HUMAN ATTRIBUTION.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Story Section -->
    <section class="py-20 bg-black">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl font-black text-yellow-400 mb-6">STORY</h2>
            <p class="text-lg text-yellow-400 mb-6 font-bold">
              FAIRMIND WAS BORN FROM A SIMPLE OBSERVATION: AS AI SYSTEMS BECOME MORE POWERFUL AND PERVASIVE, THE NEED FOR PROPER GOVERNANCE AND OVERSIGHT HAS NEVER BEEN GREATER.
            </p>
            <p class="text-lg text-yellow-400 mb-6 font-bold">
              THE P0 WORK FOCUSES ON VERSIONED TARGET AND SUITE IDENTITIES, EVIDENCE ADMISSION AND TRUST STATE, REVIEWER ATTRIBUTION, AND GOVERNANCE RECORDS.
            </p>
            <p class="text-lg text-yellow-400 font-bold">
              EVALUATOR WORKERS, PUBLIC EVALUATOR PACKS, CONTINUOUS MONITORING, AUTOMATIC REMEDIATION, CERTIFICATION, AND COMPLIANCE DETERMINATIONS REMAIN OUTSIDE THIS ALPHA.
            </p>
          </div>
          <div class="bg-black p-8 rounded-none border-2 border-yellow-400 shadow-[6px_6px_0px_0px_rgba(255,255,0,1)]">
            <h3 class="text-2xl font-black text-yellow-400 mb-4">WHY FAIRMIND?</h3>
            <ul class="space-y-3">
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-yellow-400 font-bold">VERSIONED TARGET AND SUITE BINDINGS</span>
              </li>
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-yellow-400 font-bold">DEFAULT-OFF EVIDENCE CONTROLS</span>
              </li>
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-yellow-400 font-bold">EXPLICIT TRUST AND FRESHNESS STATES</span>
              </li>
              <li class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-yellow-400 font-bold">HUMAN REVIEW; NO AUTOMATIC CERTIFICATION</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-black text-yellow-400 border-t-2 border-yellow-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl font-black mb-6">REVIEW THE ALPHA BOUNDARY</h2>
        <p class="text-xl text-yellow-400 mb-8 max-w-3xl mx-auto font-bold">
          REVIEW THE SOURCE AND ROADMAP, OR ASK ABOUT BOUNDED INTERNAL-ALPHA ACCESS.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <a href="/request-access" class="inline-flex items-center px-8 py-4 bg-yellow-400 text-black font-black rounded-none border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transform hover:-translate-y-2 transition-all">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            REQUEST ALPHA ACCESS
          </a>
          <a href="https://github.com/adhit-r/fairmind/tree/main/apps/docs/content/docs" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-8 py-4 border-2 border-yellow-400 text-yellow-400 font-black rounded-none hover:bg-yellow-400 hover:text-black transition-all shadow-[4px_4px_0px_0px_rgba(255,255,0,1)] hover:shadow-[6px_6px_0px_0px_rgba(255,255,0,1)]">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            READ REPOSITORY DOCS
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
