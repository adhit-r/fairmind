---
import Layout from '../layouts/Layout.astro';
import '../styles/pages.css';
---

<Layout title="404 | Evidence not found" description="The requested FairMind page could not be found." noindex={true}>
  <div class="route-page">
    <section class="route-section route-section-dark" style="min-height: 72vh; display: grid; align-items: center;">
      <div class="route-split">
        <div class="route-split-copy">
          <p class="route-signal">404 · evidence not found</p>
          <h1 style="font-size: clamp(4rem, 10vw, 8rem); line-height: .88; letter-spacing: -.04em; margin: 0;">This route has insufficient data.</h1>
          <p style="color: rgba(255,255,255,.78);">We refuse to convert a missing page into a pass. Return to the product, inspect the roadmap, or ask a precise question.</p>
          <div class="route-actions"><a class="button button-primary" href="/">Return home</a><a class="button button-secondary" href="/roadmap">Inspect roadmap</a></div>
        </div>
        <div class="route-quote"><blockquote>Missing route. No invented result.</blockquote></div>
      </div>
    </section>
  </div>
</Layout>
