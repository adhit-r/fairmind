---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import '../styles/pages.css';
---

<Layout title="404 | Evidence not found" description="The requested FairMind page could not be found." noindex={true}>
  <div class="route-page">
    <PageHero
      signal="404"
      title="This route has"
      accent="insufficient data."
      description="We refuse to turn a missing page into a pass. Return to the product, or ask a precise question."
      proofs={[
        { label: 'Status', value: 'No record', note: 'Nothing at this address, and nothing invented to fill it.' },
        { label: 'Next', value: 'Platform', note: 'The system file, packs, the release gate and the evidence ledger.' },
      ]}
      primary={{ label: 'Return home', href: '/' }}
      secondary={{ label: 'See the platform', href: '/features/' }}
      dark={true}
    />
  </div>
</Layout>
