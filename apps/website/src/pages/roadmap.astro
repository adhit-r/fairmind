---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import '../styles/pages.css';

const phases = [
  {
    category: 'current',
    state: 'Observed checkpoint',
    title: 'Useful evidence paths exist, but the assurance spine is incomplete.',
    items: [
      'Environmental governance is the strongest bounded vertical slice.',
      'Governance records, approvals, risks, remediation, and evidence exist across overlapping models.',
      'The LLM judge depends on a named external provider; AI BOM is a metadata transformation.',
      'Workbench evidence records are still mutable and are not yet immutable Evidence Passports.',
    ],
  },
  {
    category: 'p0',
    state: 'P0 · claim safety',
    title: 'Make every visible result tell the truth about its evidence.',
    items: [
      'Enforce organization scope across systems, evidence, mappings, approvals, and reports.',
      'Add immutable framework versions, source hashes, evidence-run identities, and reviewed mappings.',
      'Remove mock-pass and browser-generated results; unavailable means unavailable.',
      'Make artifacts integrity-aware and produce reports from a pinned canonical manifest.',
    ],
  },
  {
    category: 'p1',
    state: 'P1 · reliable foundation',
    title: 'Close one complete evaluation-to-decision loop.',
    items: [
      'Make the assurance router required and consolidate the active governance data path.',
      'Connect environmental evidence and one real tabular or LLM adapter to a canonical ingestion port.',
      'Derive readiness from applicability, accepted mappings, freshness, findings, policies, and approvals.',
      'Preserve compatibility gates until the replacement path proves closure.',
    ],
  },
  {
    category: 'p2',
    state: 'P2 · coherence',
    title: 'Reduce surface area and widen the adapter ecosystem.',
    items: [
      'Consolidate the dashboard into six assurance tasks with tested redirects.',
      'Add artifact adapters for Giskard, MLflow, Fairlearn/AIF360, ModelScan, and garak/PyRIT.',
      'Connect AI BOM and environmental exports to the same canonical manifest.',
      'Retire mock provenance, duplicate endpoint families, and placeholder services after closure tests.',
    ],
  },
];
---

<Layout
  title="FairMind product roadmap | AI assurance evidence"
  description="The FairMind recovery sequence: truthful capability states, immutable evidence, human-reviewed mappings, findings, retests, and reproducible assurance packages."
>
  <div class="route-page">
    <PageHero
      signal="Public recovery sequence · evidence before claims"
      title="A roadmap with"
      accent="acceptance criteria."
      description="This is not a feature wish list. It is the sequence for turning the current FairMind workbench into a defensible assurance system without allowing mock, missing, or insufficient evidence to look complete."
      proofs={[
        { label: 'Observed today', value: 'Bounded evidence paths', note: 'Environmental evidence is the strongest implemented vertical slice.' },
        { label: 'Recovery contract', value: 'Immutable Evidence Passport', note: 'Subject, threshold, artifact, limitation, reviewer, remediation, and rerun.' },
        { label: 'Exit condition', value: 'Same input. Same manifest.', note: 'Changed content under the same run identity must be rejected.' },
      ]}
      primary={{ label: 'Inspect the recovery sequence', href: '#recovery-sequence' }}
      secondary={{ label: 'Read capability truth', href: '/#capabilities' }}
    />

    <section class="route-section" id="recovery-sequence" aria-labelledby="roadmap-title">
      <header class="route-section-heading">
        <h2 id="roadmap-title">Current state and recovery priority are different things.</h2>
        <p>The labels below describe the July 2026 recovery decision record. They do not silently promote a planned capability into a shipped one.</p>
      </header>

      <div class="roadmap-controls" role="group" aria-label="Filter recovery roadmap">
        <button type="button" class="is-active" data-roadmap-filter="all" aria-pressed="true">Entire sequence</button>
        <button type="button" data-roadmap-filter="current" aria-pressed="false">Observed checkpoint</button>
        <button type="button" data-roadmap-filter="p0" aria-pressed="false">P0 · claim safety</button>
        <button type="button" data-roadmap-filter="p1" aria-pressed="false">P1 · foundation</button>
        <button type="button" data-roadmap-filter="p2" aria-pressed="false">P2 · coherence</button>
      </div>

      <div data-roadmap-list>
        {phases.map((phase) => (
          <article class="roadmap-phase" data-roadmap-category={phase.category}>
            <span class:list={['route-state', phase.category === 'p0' && 'route-state-orange', phase.category === 'current' && 'route-state-dark']}>{phase.state}</span>
            <h2>{phase.title}</h2>
            <ul>
              {phase.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="route-section route-section-dark" aria-labelledby="acceptance-title">
      <div class="route-split">
        <div class="route-split-copy">
          <h2 id="acceptance-title">The recovery is credible when one real run closes the loop.</h2>
          <p>Run or import a real evaluation, preserve its identity and artifacts, expose the limitation, route the mapping to an independent reviewer, retain the failure, link remediation and a clean retest, then reproduce the same framework-pinned manifest at the same evidence cutoff.</p>
        </div>
        <div class="route-quote">
          <blockquote>Missing evidence never becomes a pass.</blockquote>
        </div>
      </div>
    </section>

    <section class="route-closing" aria-labelledby="roadmap-closing-title">
      <div>
        <p>Bring the evaluation output you already have</p>
        <h2 id="roadmap-closing-title">Help close a real evidence path.</h2>
      </div>
      <div class="route-actions">
        <a class="button button-primary" href="/request-access">Request access</a>
        <a class="button button-secondary" href="https://github.com/adhit-r/fairmind">Inspect the source</a>
      </div>
    </section>
  </div>
</Layout>

<script>
  document.querySelectorAll('[data-roadmap-filter]').forEach((filter) => {
    filter.addEventListener('click', () => {
      if (!(filter instanceof HTMLButtonElement)) return;
      const selected = filter.dataset.roadmapFilter || 'all';
      document.querySelectorAll('[data-roadmap-filter]').forEach((item) => {
        if (!(item instanceof HTMLButtonElement)) return;
        const active = item === filter;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      document.querySelectorAll('[data-roadmap-category]').forEach((phase) => {
        if (!(phase instanceof HTMLElement)) return;
        phase.hidden = selected !== 'all' && phase.dataset.roadmapCategory !== selected;
      });
    });
  });
</script>
