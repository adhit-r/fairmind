---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import '../styles/pages.css';

const phases = [
  {
    when: 'Shipped',
    items: [
      { title: 'System file and six-stage journey', body: 'Derived stage, one next action per stage, decision recorded and evidence sealed.' },
      { title: 'Packs catalogue v2.3', body: '50 frameworks, 21 packs, 90 workflows, 109 evaluations, 8 bundles, 28 framework journeys.' },
      { title: 'Workflow builder and run engine', body: 'Drafts, immutable published versions, validation that keeps a human gate, hash-chained run ledger.' },
      { title: 'Release gate, CLI, GitHub Action', body: 'Five checks, confidence-weighted verdict, exit codes a pipeline can act on.' },
      { title: 'Fairness test and environmental evaluation', body: 'Measured evidence with confidence intervals; FairMind-E measurement path.' },
      { title: 'MLflow and GitHub connectors', body: 'Suggested tier and stage; a person promotes assets into governance.' },
    ],
  },
  {
    when: 'Next',
    items: [
      { title: 'Agent-executed steps', body: 'Collect, check and suggest steps run by the FairMind agent, behind the same gates, with citations required and abstain-over-guess. Starting with workflows whose inputs are already connected.' },
      { title: 'Producers for the attest-only gate checks', body: 'Data governance and human oversight evidence from workflows and connectors rather than attestations alone.' },
      { title: 'Autonomy levels enforced in the engine', body: 'A1 to A3 as runtime policy per workflow, not catalogue labels.' },
      { title: 'More connectors', body: 'Model registries and experiment trackers beyond MLflow; agent frameworks and MCP server inventories.' },
    ],
  },
  {
    when: 'Later',
    items: [
      { title: 'Evidence Passport v2', body: 'Admission, trust and signing routes; cross-tenant portability of sealed evidence.' },
      { title: 'External anchoring of the ledger', body: 'The run ledger is tamper-evident today; anchoring makes it independently verifiable.' },
      { title: 'Python SDK and MCP server', body: 'Gate, test and systems as library calls and as tools an agent can use.' },
      { title: 'Separation of duties in code', body: 'The catalogue declares it for 32 workflows; the engine should refuse the same person on both sides.' },
    ],
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fairmind.xyz/' },
    { '@type': 'ListItem', position: 2, name: 'Roadmap', item: 'https://fairmind.xyz/roadmap/' },
  ],
};
---

<Layout
  title="FairMind roadmap: shipped, next, later"
  description="What FairMind has shipped, what is next, and what comes later: agent-executed workflow steps behind human gates, producers for every gate check, enforced autonomy levels, Evidence Passport v2, ledger anchoring, SDK and MCP server."
  structuredData={structuredData}
>
  <div class="route-page">
    <PageHero
      signal="Roadmap"
      title="Shipped, next,"
      accent="later."
      description="We publish the state of the product rather than a wish list. If a capability is listed under Shipped, it is on main and in the walkthrough. If it is under Next, it is being built behind the same human gates."
      proofs={[
        { label: 'Principle', value: 'Evidence before claims', note: 'Nothing moves to Shipped without a test behind it.' },
        { label: 'Constant', value: 'A person at every gate', note: 'Automation widens what the agent prepares, never what it decides.' },
        { label: 'Cadence', value: 'Monthly', note: 'This page is updated with each release.' },
      ]}
      primary={{ label: 'Request access', href: '/request-access/' }}
      secondary={{ label: 'Research notes', href: '/blog/' }}
    />

    {phases.map((p) => (
      <section class:list={['route-section', p.when === 'Next' && 'route-section-dark']} aria-labelledby={`phase-${p.when}`}>
        <header class="route-section-heading"><h2 id={`phase-${p.when}`}>{p.when}</h2></header>
        <div class="route-ledger">
          {p.items.map((it) => (
            <article class="route-ledger-row"><span>{p.when}</span><h3>{it.title}</h3><p>{it.body}</p></article>
          ))}
        </div>
      </section>
    ))}

    <section class="route-closing" aria-labelledby="roadmap-closing-title">
      <h2 id="roadmap-closing-title">Want something moved up?</h2>
      <p>Tell us the framework, the workflow, or the connector. Design partners shape the order.</p>
      <div class="route-actions"><a class="button button-primary" href="/contact/">Contact us</a><a class="button" href="/features/">See what shipped</a></div>
    </section>
  </div>
</Layout>
