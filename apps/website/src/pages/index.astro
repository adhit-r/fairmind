---
import { registryTotals } from '../lib/registry';
import Layout from '../layouts/Layout.astro';
import { frameworks } from '../lib/frameworks';
import '../styles/home.css';

const stats = [
  { n: String(registryTotals.frameworks), t: 'Frameworks in the registry, EU AI Act to OWASP Agentic' },
  { n: '90', t: 'Governance workflows agents can run' },
  { n: '109', t: 'Evaluations mapped to requirement IDs' },
  { n: '21', t: 'Packs across Govern, Evaluate, Secure, Comply' },
  { n: '0', t: 'External changes made without a human approval' },
];

const steps = [
  { n: '01', title: 'Collect', body: 'Policies, tickets, model cards, logs. Read-only scopes.' },
  { n: '02', title: 'Check', body: 'Rules first, model second. Every finding cites its source.' },
  { n: '03', title: 'Suggest', body: 'The record, mapping, or fix, with its confidence stated.' },
  {
    n: '04 · Gate', title: 'You', body: 'Approve, edit, or reject. Deny by default.', gate: true,
    who: 'Waiting on a person', approved: { body: 'Decision recorded.', who: 'Approved by you' }, rejected: { body: 'Nothing changed.', who: 'Rejected by you' },
  },
  { n: '05', title: 'Act', body: 'Dry run, blast radius, rollback plan. Then the change.' },
  { n: '06', title: 'Verify', body: 'Re-read the target. A mismatch rolls back and escalates.' },
  {
    n: '07', title: 'File evidence', body: 'Hash-chained trace, mapped to every requirement it satisfies.',
    approved: { body: 'Chained to the previous run and mapped to its requirement.' }, rejected: { body: 'The rejection is filed too, with the reason.' },
  },
];

const autonomy = [
  { level: 'A0', name: 'Manual', detail: 'The agent does nothing unless asked for a draft.' },
  { level: 'A1', name: 'Assist', detail: 'Collects and checks. Humans write every conclusion.' },
  { level: 'A2', name: 'Propose', detail: 'Proposes; nothing is recorded until a human approves. The default.' },
  { level: 'A3', name: 'Act on internal records', detail: 'Files records inside FairMind; humans review by sampling. Never external writes.' },
];

const pillars = [
  { name: 'Govern', title: 'Run the management system', body: 'Policies, accountability, inventory, risk and impact, data, suppliers.' },
  { name: 'Evaluate', title: 'Test before and after release', body: 'Quality, fairness and bias, agent behaviour, production drift.' },
  { name: 'Secure', title: 'Protect LLM apps and agents', body: 'OWASP LLM and Agentic Top 10, MITRE ATLAS, supply chain.' },
  { name: 'Comply', title: 'Show it, requirement by requirement', body: 'EU AI Act, ISO/IEC 42001, AIUC-1. Gaps shown, not hidden.' },
];

const registry = [
  { b: 'EU AI Act', s: '2024/1689', href: '/frameworks/eu-ai-act/' },
  { b: 'ISO/IEC 42001', s: '', href: '/frameworks/iso-42001/' },
  { b: 'NIST AI RMF', s: '', href: '/frameworks/nist-ai-rmf/' },
  { b: 'OWASP', s: 'Agentic Top 10', href: '/frameworks/' },
  { b: 'AIUC-1', s: '', href: '/frameworks/' },
  { b: 'OWASP', s: 'LLM Top 10', href: '/frameworks/' },
  { b: 'MITRE ATLAS', s: '', href: '/frameworks/' },
  { b: 'NIST AI 600-1', s: '', href: '/frameworks/nist-ai-rmf/' },
  { b: 'ISO/IEC 42005', s: '', href: '/frameworks/iso-42001/' },
  { b: 'CSA', s: 'MAESTRO', href: '/frameworks/' },
  { b: 'OWASP', s: 'MCP Top 10', href: '/frameworks/' },
];

const evaluations = [
  { name: 'Agents', title: 'Can it only do what it was allowed to?', body: 'Tool least privilege, out-of-scope actions blocked, MCP server permission audit, excessive agency, kill-switch time to stop, runaway containment.' },
  { name: 'LLM apps and RAG', title: 'Does it hold under attack?', body: 'Direct and indirect prompt injection, jailbreak resistance, system prompt leakage, groundedness, harmful content, over-refusal, knowledge-base poisoning.' },
  { name: 'Models and data', title: 'Is it still the model you tested?', body: 'Task accuracy, calibration, robustness, data drift, out-of-distribution detection, membership inference, backdoor detection, label quality.' },
  { name: 'Decision systems', title: 'Is it fair, with the statistics shown?', body: 'Selection-rate parity at the four-fifths rule, error-rate parity, intersectional slices, fairness drift. Suites for hiring, credit, insurance, benefits and education.' },
];

const faqs = [
  {
    q: 'What is agentic AI governance?',
    a: 'Agentic AI governance uses AI agents to run the repeatable parts of governing AI systems: collecting evidence, checking it against framework requirements, proposing records and fixes, and filing the trace. The decisions stay with people. In FairMind, every workflow stops at an approval gate before anything is recorded or changed.',
  },
  {
    q: 'What does a FairMind agent actually do?',
    a: 'It runs a workflow made of seven step types: collect, check, suggest, ask a person, act, verify, and file evidence. Today the trigger, escalate and file steps run themselves, the gate steps open an approval request, and a person completes the collect, check, suggest, act and verify steps, which the ledger records as manual. Agent-executed steps arrive workflow by workflow, behind the same gates, with scoped read-only credentials, rules before model judgement, and a citation for every finding.',
  },
  {
    q: 'What does FairMind evaluate?',
    a: 'The catalogue defines 109 evaluations: 53 for security, 46 for behaviour and fairness, and 10 for governance and compliance. They cover agents (tool least privilege, out-of-scope actions, MCP permissions, kill switches), LLM apps and RAG (prompt injection, jailbreaks, prompt leakage, groundedness, harmful content), models and data (accuracy, calibration, drift, membership inference, backdoors) and decision systems (selection-rate parity, error-rate parity, intersectional slices). Each one names its metric, its threshold and where that threshold comes from, and every evaluator declares whether it is validated, runs through an external provider, reads metadata only, or is not yet available.',
  },
  {
    q: 'Can the agent change things on its own?',
    a: 'Only inside FairMind, and only if you set that workflow to autonomy level A3. The default is A2: the agent proposes and a person approves. External systems are never written without an approval. If an approver is unreachable or no policy covers the action, nothing happens.',
  },
  {
    q: 'Which frameworks does FairMind cover?',
    a: `The registry holds ${registryTotals.frameworks} frameworks, including the EU AI Act, ISO/IEC 42001, NIST AI RMF and AI 600-1, the OWASP Top 10 for LLM and Agentic applications, AIUC-1, MITRE ATLAS, the OWASP MCP Top 10, CSA MAESTRO, Singapore’s Model AI Governance Framework, and national rules from India, Japan, Korea, China and US states. One workflow run counts toward every requirement it maps to.`,
  },
  {
    q: 'How is FairMind’s own agent governed?',
    a: 'Twenty runtime controls apply to it: per-step scoped identity, a deterministic tool allowlist that prompts cannot widen, collected content treated as data rather than instructions, mandatory citations, pinned model and prompt versions with golden-set evaluations, a hash-chained immutable trace, cost and rate caps, and a kill switch per run. Customers can see the agent’s metrics and incidents.',
  },
  {
    q: 'Is FairMind a certification?',
    a: 'No. FairMind produces and organises evidence and records human decisions. Certification and conformity decisions stay with your reviewers, auditors, and, where relevant, accredited bodies.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'FairMind',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: 'https://fairmind.xyz',
    description:
      `Agentic AI governance platform: 90 governance workflows, 109 evaluations and ${registryTotals.frameworks} frameworks, with a human gate in every workflow and a hash-chained record of each run. Covers EU AI Act, ISO/IEC 42001, NIST AI RMF, OWASP LLM and Agentic Top 10, MITRE ATLAS and AIUC-1.`,
    publisher: { '@id': 'https://fairmind.xyz/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="FairMind: agentic AI governance platform"
  description={`Agentic AI governance: 90 workflows, 109 evaluations and ${registryTotals.frameworks} frameworks, with a human gate in every workflow. EU AI Act, ISO/IEC 42001, NIST AI RMF, OWASP Agentic, MITRE ATLAS, AIUC-1.`}
  structuredData={structuredData}
>
  <div class="story" data-story>
    <div class="stage" data-stage>
      <canvas data-canvas aria-hidden="true"></canvas>
      <p class="counter" aria-live="polite">
        <b data-counter>0</b>
        <span>items approved by you</span>
        <em>24,000 checks in the run · 0 changed without you</em>
      </p>
      <div class="scroll-cue" aria-hidden="true"><i></i>Scroll</div>
    </div>

    <div class="panels">
      <section class="panel" aria-labelledby="hero-title">
        <div class="wrap">
          <p class="label reveal">Agentic AI governance</p>
          <h1 id="hero-title" class="reveal" style="transition-delay: 80ms">
            Governance that runs itself.<br />Decisions that stay <em>human.</em>
          </h1>
          <p class="panel-intro reveal" style="transition-delay: 160ms">
            FairMind runs governance as agent workflows: collect, check, suggest, act, verify, file.
            Every workflow stops at a gate, and a person decides. Right now, that person is you.
          </p>
          <div class="panel-actions reveal" style="transition-delay: 240ms">
            <a class="button button-primary" href="/request-access/" data-magnet>Request access <span class="arr" aria-hidden="true">→</span></a>
            <a class="button" href="#how-a-run-works" data-magnet>How a run works</a>
          </div>
        </div>
      </section>

      <section class="panel" aria-label="What the tunnel shows">
        <div class="wrap">
          <div class="glass reveal">
            <p class="label">What you just did</p>
            <h2>Every tile is a check in a run. It stayed grey until <em>you</em> looked at it.</h2>
            <p>Deny by default. Nothing is recorded or changed until an approver decides, and every decision is kept with who made it and why.</p>
          </div>
        </div>
      </section>

      <section class="panel" aria-label="The evidence trail">
        <div class="wrap">
          <div class="glass reveal">
            <p class="label">Behind you</p>
            <h2>Your decisions become the <em>evidence trail.</em></h2>
            <p>A hash-chained trace of inputs, model calls, tool calls, and approvals, mapped to the requirements it satisfies. Auditors read the trail; they don't take our word for it.</p>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="strip" aria-label="FairMind by the numbers">
    <div class="wrap">
      {stats.map((s) => (<div><b>{s.n}</b><span>{s.t}</span></div>))}
    </div>
  </div>

  <section class="section" id="how-a-run-works">
    <div class="wrap">
      <header class="section-heading">
        <p class="label reveal">How a run works</p>
        <h2 class="reveal">The agent stops at you. <em>Nothing moves until you decide.</em></h2>
      </header>
      <div class="run" data-run data-state="waiting">
        <div class="run-track" aria-hidden="true"><i></i></div>
        <ol class="run-steps">
          {steps.map((s, i) => (
            <li class:list={['run-step', s.gate && 'gate', i > 3 && 'after', i === 6 && 'filed']}>
              <span class="run-dot" aria-hidden="true"></span>
              <p class="label">{s.n}</p>
              <b>{s.title}</b>
              <span class="run-body" data-waiting={s.body} data-approved={s.approved?.body} data-rejected={s.rejected?.body}>{s.body}</span>
              <span class="run-who" data-waiting={s.who ?? 'Agent'} data-approved={s.approved?.who} data-rejected={s.rejected?.who}>{s.who ?? 'Agent'}</span>
            </li>
          ))}
        </ol>
        <div class="run-decision">
          <p aria-live="polite" data-waiting="The agent suggests mapping this fairness run to EU AI Act Article 10(2)(f)." data-approved="Applied, verified, filed. Steps 05 to 07 ran because you approved." data-rejected="Steps 05 and 06 never ran. The trail shows why.">The agent suggests mapping this fairness run to EU AI Act Article 10(2)(f).</p>
          <div class="run-actions">
            <button type="button" class="button button-primary button-compact" data-run-to="approved">Approve</button>
            <button type="button" class="button button-compact" data-run-to="rejected">Reject</button>
            <button type="button" class="button button-compact" data-run-to="waiting" hidden>Run again</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-grey" id="autonomy">
    <div class="wrap split">
      <header>
        <p class="label reveal">Autonomy</p>
        <h2 class="reveal">You set how far the agent goes. <em>Per workflow.</em></h2>
        <p class="split-lead reveal">Internal audit stays at Assist. Inventory upkeep can run at Act. External systems are never written without a person.</p>
      </header>
      <div class="ladder reveal">
        {autonomy.map((a) => (
          <div><b>{a.level}</b><span>{a.name}</span><span>{a.detail}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="packs">
    <div class="wrap">
      <header class="section-heading">
        <p class="label reveal">Four pillars</p>
        <h2 class="reveal">Install the packs your systems <em>need.</em></h2>
      </header>
      <div class="grid-4">
        {pillars.map((p, i) => (
          <article class="card tilt reveal" style={`transition-delay: ${i * 80}ms`}>
            <p class="label">{p.name}</p>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-grey" id="evaluations">
    <div class="wrap">
      <header class="section-heading">
        <p class="label reveal">109 evaluations</p>
        <h2 class="reveal">Tests for the systems you actually run. <em>Thresholds declared first.</em></h2>
        <p class="reveal">Each evaluation names its metric, its threshold and where that threshold comes from. Each evaluator says whether it is validated, external, metadata only, or not yet available.</p>
      </header>
      <div class="grid-4">
        {evaluations.map((e, i) => (
          <article class="card tilt reveal" style={`transition-delay: ${i * 80}ms`}>
            <p class="label">{e.name}</p>
            <h3>{e.title}</h3>
            <p>{e.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <nav class="marquee" aria-label="Frameworks in the registry">
    <ul>
      {[...registry, ...registry].map((r) => (
        <li><a href={r.href}><b>{r.b}</b> {r.s}</a></li>
      ))}
    </ul>
  </nav>

  <section class="section" id="governed-agent">
    <div class="wrap split" style="align-items: center">
      <header>
        <p class="label reveal">The agent is governed too</p>
        <h2 class="reveal">Twenty controls on <em>our own</em> agent.</h2>
        <p class="split-lead reveal">
          Per-step scoped identity. A deterministic tool allowlist prompts cannot widen. Collected
          content treated as data, never instructions. A hash-chained trace of every call. A kill
          switch per run. You can see our agent's metrics and incidents; we cannot hide them.
        </p>
      </header>
      <div class="card trace reveal" aria-label="Example run trace">
        <div>
          <div><span class="dim">run</span> 7f3a…c21e <span class="dim">workflow</span> deployment_release_gate@v4</div>
          <div><i>collect</i> 14 items · scopes: read</div>
          <div><i>check</i> 11 pass · 2 fail · 1 cannot conclude</div>
          <div><i>suggest</i> finding RSK-0412, cites item 9 §3</div>
          <div class="hi"><i class="ask">ask</i> approver: priya.n · decision: approve with edits</div>
          <div><i>act</i> dry-run ok · blast radius 1 record</div>
          <div><i>verify</i> target re-read · match</div>
          <div><i>file</i> evidence → ISO42001 6.1.2, EUAIA Art.9, NISTRMF GOVERN 1.7</div>
          <div class="dim">trace sha256 e1b0…9a44 · chained to previous run</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-grey" id="faq">
    <div class="wrap">
      <header class="section-heading">
        <h2 class="reveal">Questions teams ask</h2>
      </header>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band reveal">
        <h2>Let the agents do the paperwork. Keep the <em>decisions.</em></h2>
        <a class="button" href="/request-access/" data-magnet>Request access <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <script>
    const run = document.querySelector<HTMLElement>('[data-run]');
    if (run) {
      const texts = run.querySelectorAll<HTMLElement>('[data-waiting]');
      run.addEventListener('click', (event) => {
        const to = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-run-to]')?.dataset.runTo;
        if (!to) return;
        run.dataset.state = to;
        texts.forEach((el) => (el.textContent = el.dataset[to] ?? el.dataset.waiting ?? ''));
        run.querySelectorAll<HTMLButtonElement>('[data-run-to]').forEach((b) => {
          b.hidden = to === 'waiting' ? b.dataset.runTo === 'waiting' : b.dataset.runTo !== 'waiting';
        });
      });
    }
  </script>
  <script>
    import { mountTunnel } from '../scripts/tunnel';
    const story = document.querySelector<HTMLElement>('[data-story]');
    const stage = document.querySelector<HTMLElement>('[data-stage]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-canvas]');
    const counter = document.querySelector<HTMLElement>('[data-counter]');
    if (story && stage && canvas && counter) {
      try {
        mountTunnel(story, stage, canvas, counter);
      } catch {
        canvas.remove();
      }
    }
  </script>
</Layout>
