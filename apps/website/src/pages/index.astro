---
import Layout from '../layouts/Layout.astro';
import { frameworks } from '../lib/frameworks';
import '../styles/home.css';

const record = [
  { label: 'AI system', state: 'Credit scoring v3' },
  { label: 'Bias evaluation', state: 'Finding raised', tone: 'alert' },
  { label: 'Remediation', state: 'Owner assigned' },
  { label: 'Framework mapping', state: 'EU AI Act Art. 10', tone: 'teal' },
  { label: 'Reviewer decision', state: 'Awaiting review', tone: 'pending' },
];

const pillars = [
  {
    step: '01 Detect',
    title: 'Bias and safety testing',
    body: 'Run fairness and safety evaluations, or import results from the tools you already use. Thresholds are fixed before the run, not after.',
  },
  {
    step: '02 Remediate',
    title: 'Fixes linked to retests',
    body: 'Every finding gets an owner, a fix, and a retest that links back to the original failure. History is kept, never overwritten.',
  },
  {
    step: '03 Prove',
    title: 'Audit-ready packages',
    body: 'Export evidence mapped to versioned framework controls, with human sign-off recorded and open findings left visible.',
  },
];

const steps = [
  { title: 'Register the AI system', body: 'Model, version, owner, deployment, and intended use.' },
  { title: 'Evaluate or import results', body: 'Bias, fairness, and safety runs bound to that exact version.' },
  { title: 'Review and remediate', body: 'A named reviewer accepts or rejects each finding and mapping.' },
  { title: 'Export the assurance package', body: 'Framework-pinned evidence, decisions, limitations, and history.' },
];

const faqs = [
  {
    q: 'What is AI bias detection?',
    a: 'AI bias detection measures whether a model produces systematically different outcomes or error rates for different groups of people, such as by gender, age, region, or income. It compares results against fairness thresholds that are set before testing.',
  },
  {
    q: 'How do I test an AI model for bias?',
    a: 'Define the groups your system affects and the fairness metrics that matter for the decision, set thresholds, run the evaluation on representative data, then fix and retest anything that fails. FairMind records each step against the exact model version so the result can be audited later.',
  },
  {
    q: 'Does FairMind help with EU AI Act compliance?',
    a: 'FairMind organises the technical evidence the EU AI Act expects from high-risk AI providers, including data governance and bias examination (Article 10), risk management, logging, and human oversight, and links it to the relevant articles for human review. It does not decide conformity.',
  },
  {
    q: "What does India's DPDP Act mean for AI systems?",
    a: 'Any AI system that processes digital personal data of people in India falls under the DPDP Act, 2023. Data used to make decisions about people must be complete, accurate, and consistent, and Significant Data Fiduciaries must run impact assessments and audits.',
  },
  {
    q: 'Is FairMind a certification?',
    a: 'No. FairMind produces and organises evidence that supports a governance or audit decision. Certification and conformity decisions stay with your reviewers, auditors, and, where relevant, accredited bodies.',
  },
  {
    q: 'Can I use FairMind with my existing evaluation tools?',
    a: 'Yes. FairMind is vendor-neutral. You can bring results from the evaluators you already run and FairMind binds them to the system, threshold, reviewer, and remediation that give them meaning.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'FairMind',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: 'https://fairmind.xyz',
    description:
      'AI bias detection and governance platform that links bias testing, remediation, and human review to the EU AI Act, DPDP Act, NITI Aayog, and NIST AI RMF.',
    publisher: { '@id': 'https://fairmind.xyz/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="FairMind: AI bias detection and AI governance platform"
  description="Detect AI bias, track every fix to a retest, and export audit-ready evidence mapped to the EU AI Act, India's DPDP Act, NITI Aayog, and NIST AI RMF."
  structuredData={structuredData}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">AI bias detection · AI governance · Audit evidence</p>
        <h1>
          Find AI bias.<br />Prove it's fixed.<br /><span>Pass the audit.</span>
        </h1>
        <p class="hero-intro">
          FairMind tests your models for bias and safety issues, tracks every fix to a retest, and
          maps the evidence to the EU AI Act, India's DPDP Act, NITI Aayog principles, and NIST AI
          RMF.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/request-access/">Request access <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="#how-it-works">See how it works</a>
        </div>
      </div>

      <figure class="record" aria-label="Example FairMind evidence record">
        <figcaption class="record-head">
          <span>Evidence record</span><span class="record-status">Retest pending</span>
        </figcaption>
        <ol class="record-rows">
          {record.map((row) => (
            <li class:list={['record-row', row.tone && `record-row-${row.tone}`]}>
              <strong>{row.label}</strong>
              <span class="chip">{row.state}</span>
            </li>
          ))}
        </ol>
      </figure>
    </div>
  </section>

  <nav class="framework-strip" aria-label="Supported frameworks">
    <div class="wrap framework-strip-inner">
      <span class="kicker">Mapped to</span>
      <ul>
        {frameworks.map((f) => (
          <li><a href={`/frameworks/${f.slug}/`}>{f.shortName}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <section class="section" id="platform">
    <div class="wrap">
      <header class="section-heading">
        <h2>One platform from bias test to audit-ready evidence</h2>
        <p>Engineers, reviewers, and compliance owners work from the same record for each AI system.</p>
      </header>
      <div class="grid-3">
        {pillars.map((p, i) => (
          <article class:list={['card', i === 2 && 'card-teal']}>
            <p class="kicker">{p.step}</p>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-white" id="how-it-works">
    <div class="wrap steps-grid">
      <header>
        <h2>How FairMind works</h2>
        <p class="steps-lead">Four steps. Each one leaves a record an auditor can follow.</p>
        <a class="button button-secondary" href="/demo/">Watch the walkthrough</a>
      </header>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="steps-number" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-ink" id="frameworks">
    <div class="wrap">
      <header class="section-heading">
        <h2>Collect evidence once. Use it across frameworks.</h2>
        <p>A reviewer accepts each mapping, so one bias evaluation can support several regulations without being re-run.</p>
      </header>
      <ul class="framework-cards">
        {frameworks.map((f) => (
          <li>
            <a href={`/frameworks/${f.slug}/`}>
              <span class="kicker">{f.region} · {f.type}</span>
              <strong>{f.shortName}</strong>
              <span class="framework-cards-more">Read the guide <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <header class="section-heading">
        <h2>Questions teams ask</h2>
      </header>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-orange">
    <div class="wrap cta-band">
      <h2>Your next AI audit starts with evidence.</h2>
      <a class="button button-secondary" href="/request-access/">Request access <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
