---
import Layout from '../layouts/Layout.astro';
import EvidenceExchange from '../components/marketing/EvidenceExchange.astro';
import '../styles/home.css';

const capabilities = [
  {
    evaluator: 'Environmental evidence',
    state: 'validated',
    category: 'usable',
    output: 'Energy, carbon, water, and uncertainty records',
    boundary: 'Strongest evidence-grade vertical currently in this repository.',
  },
  {
    evaluator: 'LLM judge',
    state: 'external_provider',
    category: 'usable',
    output: 'Provider-evaluated response assessment',
    boundary: 'Requires a configured external model provider and recorded provider identity.',
  },
  {
    evaluator: 'Multimodal bias',
    state: 'metadata_only',
    category: 'bounded',
    output: 'Media metadata and statistical summary',
    boundary: 'The current path does not evaluate image, audio, or video content.',
  },
  {
    evaluator: 'AI BOM profile',
    state: 'metadata_only',
    category: 'bounded',
    output: 'Software and model inventory profile',
    boundary: 'Transforms supplied metadata; it does not independently verify the subject.',
  },
  {
    evaluator: 'Tabular bias',
    state: 'unavailable',
    category: 'blocked',
    output: 'No defensible artifact from the current route',
    boundary: 'The interface calls an evaluator endpoint that is not present.',
  },
  {
    evaluator: 'Modern LLM bias',
    state: 'unavailable',
    category: 'blocked',
    output: 'No defensible evidence artifact',
    boundary: 'The current interface produces mock results and must not be exported as evidence.',
  },
];

const graphNodes = [
  {
    key: 'system',
    label: 'AI system',
    detail: 'The exact model, agent, application, version, deployment, owner, and intended use.',
    proof: 'Creates the subject boundary before any result is interpreted.',
  },
  {
    key: 'run',
    label: 'Evaluation run',
    detail: 'Evaluator version, scope, pre-declared threshold, result, and execution identity.',
    proof: 'Separates an observed run from a floating score or screenshot.',
  },
  {
    key: 'artifact',
    label: 'Artifact',
    detail: 'The source-native output, bounded storage reference, integrity metadata, and limitations.',
    proof: 'Keeps the conclusion traceable to what the tool actually produced.',
  },
  {
    key: 'mapping',
    label: 'Candidate mapping',
    detail: 'A proposed relationship between technical evidence and a versioned governance control.',
    proof: 'A candidate mapping never satisfies a control by itself.',
  },
  {
    key: 'review',
    label: 'Reviewer decision',
    detail: 'An accountable person accepts, rejects, or narrows the mapping with a recorded rationale.',
    proof: 'This is the human boundary between evaluation and governance.',
  },
  {
    key: 'finding',
    label: 'Finding + risk',
    detail: 'A failed, missing, stale, or rejected evidence state becomes owned governance work.',
    proof: 'Missing evidence stays visible and never becomes a pass.',
  },
  {
    key: 'retest',
    label: 'Remediation + retest',
    detail: 'The fix, owner, success criteria, and clean rerun link back to the original failure.',
    proof: 'A passing retest supersedes current state without deleting history.',
  },
  {
    key: 'package',
    label: 'Assurance package',
    detail: 'A framework-pinned evidence index, unresolved findings, decisions, limitations, and history.',
    proof: 'The package supports a decision. It is not a certificate.',
  },
];
---

<Layout
  title="FairMind · Bring your tests. Produce evidence you can defend."
  description="FairMind is a vendor-neutral AI assurance evidence workbench connecting evaluator output, provenance, human review, remediation, retests, and assurance reporting."
>
  <section class="fm-hero" id="what-fairmind-does">
    <div class="fm-hero-copy">
      <p class="fm-hero-kicker">AI evaluation · AI safety · AI governance</p>
      <h1><span>Bring your tests.</span><span>Produce evidence you can defend.</span></h1>
      <p class="fm-hero-intro">
        FairMind is the vendor-neutral evidence workbench between your AI test tools and your
        governance process. It binds every result to the system, threshold, artifact,
        limitation, reviewer, finding, remediation, and retest that give it meaning.
      </p>
      <div class="fm-hero-actions">
        <a class="button button-primary" href="#evidence-exchange">Explore the evidence layer</a>
        <a class="button button-secondary" href="#capabilities">See current capability</a>
      </div>
      <dl class="fm-hero-proof">
        <div><dt>Input</dt><dd>Your evaluator output</dd></div>
        <div><dt>FairMind adds</dt><dd>Context + chain of custody</dd></div>
        <div><dt>Decision</dt><dd>Always human</dd></div>
      </dl>
    </div>
    <div id="evidence-exchange">
      <EvidenceExchange />
    </div>
  </section>

  <section class="fm-definition" aria-label="FairMind definition">
    <p>
      <strong>FairMind connects evaluators to accountable governance.</strong>
      It does not replace the evaluator, infer compliance, issue certification, or approve an AI
      system because a dashboard turned green.
    </p>
    <a href="#evidence-graph">See the evidence graph</a>
  </section>

  <section class="fm-role-section" id="workbench" aria-labelledby="roles-title">
    <header class="fm-section-heading fm-section-heading-split">
      <h2 id="roles-title">Three teams. One evidence record.</h2>
      <p>
        Engineers, reviewers, and assurance owners enter at different points. FairMind keeps them
        anchored to the same AI system and the same source artifacts.
      </p>
    </header>

    <div class="role-workbench" data-role-workbench>
      <div class="role-tabs" role="tablist" aria-label="FairMind user workflow">
        <button type="button" role="tab" id="role-engineer" aria-controls="panel-engineer" aria-selected="true" data-role-tab="engineer">
          <span>01</span> I run tests
        </button>
        <button type="button" role="tab" id="role-reviewer" aria-controls="panel-reviewer" aria-selected="false" data-role-tab="reviewer">
          <span>02</span> I review evidence
        </button>
        <button type="button" role="tab" id="role-owner" aria-controls="panel-owner" aria-selected="false" data-role-tab="owner">
          <span>03</span> I own the decision
        </button>
      </div>

      <div class="role-panel" id="panel-engineer" role="tabpanel" aria-labelledby="role-engineer" data-role-panel="engineer">
        <div class="role-panel-copy">
          <p>For ML engineers and security testers</p>
          <h3>Keep the result attached to the thing you actually tested.</h3>
          <p>Register the system boundary, bring or run an evaluator, record the threshold before interpretation, and preserve the source artifact with its limitations.</p>
        </div>
        <ol class="role-task-rail">
          <li><span>System</span><strong>Name the exact subject and version</strong></li>
          <li><span>Evaluation</span><strong>Record scope, threshold, and result</strong></li>
          <li><span>Evidence</span><strong>Preserve artifact identity and limitations</strong></li>
        </ol>
        <p class="role-output"><span>Output</span> Reviewable evidence record</p>
      </div>

      <div class="role-panel" id="panel-reviewer" role="tabpanel" aria-labelledby="role-reviewer" data-role-panel="reviewer" hidden>
        <div class="role-panel-copy">
          <p>For model-risk, compliance, and independent reviewers</p>
          <h3>Review what the evidence proves—and where it stops.</h3>
          <p>Inspect capability state, provenance, thresholds, freshness, and limitations. Accept, reject, or narrow candidate control mappings with your rationale attached.</p>
        </div>
        <ol class="role-task-rail">
          <li><span>Truth</span><strong>See validated, bounded, or unavailable</strong></li>
          <li><span>Mapping</span><strong>Review the proposed control relationship</strong></li>
          <li><span>Decision</span><strong>Record reviewer identity and rationale</strong></li>
        </ol>
        <p class="role-output"><span>Output</span> Human-reviewed evidence mapping</p>
      </div>

      <div class="role-panel" id="panel-owner" role="tabpanel" aria-labelledby="role-owner" data-role-panel="owner" hidden>
        <div class="role-panel-copy">
          <p>For AI assurance leads and accountable owners</p>
          <h3>Make release decisions with failures, fixes, and unknowns intact.</h3>
          <p>Turn evidence gaps into findings, assign remediation, require a linked retest, pin the framework version, and export the evidence index behind the decision.</p>
        </div>
        <ol class="role-task-rail">
          <li><span>Finding</span><strong>Own the blocker and remediation</strong></li>
          <li><span>Retest</span><strong>Link the clean run to the failure</strong></li>
          <li><span>Package</span><strong>Export decisions, limits, and history</strong></li>
        </ol>
        <p class="role-output"><span>Output</span> Decision-ready assurance package</p>
      </div>
    </div>
  </section>

  <section class="fm-graph-section" id="evidence-graph" aria-labelledby="graph-title">
    <header class="fm-section-heading fm-graph-heading">
      <div>
        <h2 id="graph-title">The graph is the product.</h2>
        <p>Not another score. A durable relationship between the test, the evidence, the reviewer, and what happened next.</p>
      </div>
      <p class="fm-graph-instruction">Focus or select a node to inspect why it exists.</p>
    </header>

    <div class="evidence-graph" data-evidence-graph>
      <div class="evidence-graph-track" role="group" aria-label="Canonical assurance graph">
        {
          graphNodes.map((node, index) => (
            <button
              type="button"
              class:list={['graph-node', index === 0 && 'is-active']}
              data-graph-node={node.key}
              data-graph-detail={node.detail}
              data-graph-proof={node.proof}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{node.label}</strong>
            </button>
          ))
        }
      </div>
      <div class="graph-detail" aria-live="polite">
        <span data-graph-index>01 / AI system</span>
        <p data-graph-detail>{graphNodes[0].detail}</p>
        <strong data-graph-proof>{graphNodes[0].proof}</strong>
      </div>
    </div>
  </section>

  <section class="fm-capability-section" id="capabilities" aria-labelledby="capability-title">
    <header class="fm-section-heading fm-section-heading-split">
      <h2 id="capability-title">Capability truth is part of the interface.</h2>
      <p>
        Current implementation state is shown per evaluator. It describes what evidence a route
        can produce today—not compliance, certification, or product vision.
      </p>
    </header>

    <div class="capability-controls" role="group" aria-label="Filter capabilities">
      <button type="button" class="is-active" data-capability-filter="all" aria-pressed="true">All routes</button>
      <button type="button" data-capability-filter="usable" aria-pressed="false">Usable paths</button>
      <button type="button" data-capability-filter="bounded" aria-pressed="false">Bounded metadata</button>
      <button type="button" data-capability-filter="blocked" aria-pressed="false">Unavailable</button>
    </div>

    <div class="capability-ledger" data-capability-ledger>
      {
        capabilities.map((capability) => (
          <article class="capability-row" data-capability-category={capability.category}>
            <div>
              <strong>{capability.evaluator}</strong>
              <span>{capability.state}</span>
            </div>
            <p>{capability.output}</p>
            <p>{capability.boundary}</p>
          </article>
        ))
      }
    </div>
    <div class="capability-contract-note">
      <strong>Current recovery boundary</strong>
      <p>Workbench records are still mutable and are not yet the immutable Evidence Passports defined by the target exchange contract.</p>
      <a href="/roadmap">Inspect the recovery roadmap</a>
    </div>
  </section>

  <section class="fm-adapter-section" aria-labelledby="adapter-title">
    <div>
      <h2 id="adapter-title">Use the evaluators you already trust.</h2>
      <p>
        FairMind’s opening is not to rebuild every test engine. It is to preserve outputs from
        model, data, LLM, agent, security, provenance, and environmental tools in one reviewable
        evidence chain.
      </p>
    </div>
    <div class="adapter-register">
      <div>
        <span>Current product paths</span>
        <p>Environmental evidence · provider-backed LLM judge · AI BOM transformation</p>
      </div>
      <div>
        <span>Prioritized adapter targets</span>
        <p>Giskard · MLflow · Fairlearn / AIF360 · ModelScan · garak / PyRIT</p>
      </div>
      <div>
        <span>What FairMind adds</span>
        <p>System identity · thresholds · limitations · review · remediation · framework reuse</p>
      </div>
    </div>
  </section>

  <section class="fm-research-section" id="research" aria-labelledby="research-title">
    <header class="fm-section-heading fm-section-heading-split">
      <h2 id="research-title">Research ships with its limitations attached.</h2>
      <p>Methods, artifacts, measurement status, and what remains unproven belong beside the work—not in a footnote after the claim.</p>
    </header>
    <div class="research-ledger">
      <article>
        <div><span>FairMind-E</span><strong>Measurement path validated</strong></div>
        <h3>Environmental evidence with provenance and uncertainty</h3>
        <p>Energy, carbon, water, mitigation, exception, and reviewer records. Smoke runs prove the path; real hardware evidence is still required for paper claims.</p>
        <a href="/roadmap">See research status</a>
      </article>
      <article>
        <div><span>AI BOM</span><strong>Metadata transformation</strong></div>
        <h3>A fairness evidence profile for AI inventory records</h3>
        <p>Transforms supplied BOM, bias, remediation, and unknown metadata into a reviewer-facing profile. Metadata remains metadata—not independent verification.</p>
        <a href="https://github.com/adhit-r/fairmind">Inspect the source</a>
      </article>
    </div>
  </section>

  <section class="fm-closing-section" aria-labelledby="closing-title">
    <div>
      <p>Start with the test output you already have.</p>
      <h2 id="closing-title">Keep the evidence chain. Make the decision accountable.</h2>
    </div>
    <div>
      <a class="button button-primary" href="/request-access">Request access</a>
      <a class="button button-secondary" href="https://docs.fairmind.xyz">Read the documentation</a>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('[data-role-workbench]').forEach((workbench) => {
    const tabs = workbench.querySelectorAll('[data-role-tab]');
    const panels = workbench.querySelectorAll('[data-role-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        if (!(tab instanceof HTMLButtonElement)) return;
        const role = tab.dataset.roleTab;

        tabs.forEach((item) => {
          if (!(item instanceof HTMLButtonElement)) return;
          item.setAttribute('aria-selected', String(item === tab));
        });

        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          panel.hidden = panel.dataset.rolePanel !== role;
          if (!panel.hidden) {
            panel.classList.remove('is-entering');
            void panel.offsetWidth;
            panel.classList.add('is-entering');
          }
        });
      });
    });
  });

  document.querySelectorAll('[data-evidence-graph]').forEach((graph) => {
    const nodes = graph.querySelectorAll('[data-graph-node]');
    const index = graph.querySelector('[data-graph-index]');
    const detail = graph.querySelector('[data-graph-detail]:not(button)');
    const proof = graph.querySelector('[data-graph-proof]:not(button)');

    const activate = (node) => {
      if (!(node instanceof HTMLButtonElement)) return;
      nodes.forEach((item) => {
        if (!(item instanceof HTMLButtonElement)) return;
        const active = item === node;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      const nodeIndex = Array.from(nodes).indexOf(node) + 1;
      if (index instanceof HTMLElement) index.textContent = `${String(nodeIndex).padStart(2, '0')} / ${node.textContent?.trim().replace(/^\d+/, '').trim()}`;
      if (detail instanceof HTMLElement) detail.textContent = node.dataset.graphDetail || '';
      if (proof instanceof HTMLElement) proof.textContent = node.dataset.graphProof || '';
      graph.classList.remove('is-changing');
      void graph.offsetWidth;
      graph.classList.add('is-changing');
    };

    nodes.forEach((node) => {
      node.addEventListener('click', () => activate(node));
      node.addEventListener('focus', () => activate(node));
      node.addEventListener('pointerenter', () => activate(node));
    });
  });

  document.querySelectorAll('[data-capability-filter]').forEach((filter) => {
    filter.addEventListener('click', () => {
      if (!(filter instanceof HTMLButtonElement)) return;
      const selected = filter.dataset.capabilityFilter || 'all';
      document.querySelectorAll('[data-capability-filter]').forEach((item) => {
        if (!(item instanceof HTMLButtonElement)) return;
        const active = item === filter;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      document.querySelectorAll('[data-capability-category]').forEach((row) => {
        if (!(row instanceof HTMLElement)) return;
        row.hidden = selected !== 'all' && row.dataset.capabilityCategory !== selected;
      });
    });
  });
</script>
