---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import '../styles/pages.css';

const chapters = [
  {
    n: '01',
    title: 'A connector finds the system',
    body: 'The MLflow connector lists registered models with versions, aliases and owners. Rules suggest a tier and a stage. A person promotes the credit-scoring model into governance, and a system file appears with Onboard complete and “Run the first evaluation” as the next action.',
    shows: 'Integrations review queue, system file, derived stage.',
  },
  {
    n: '02',
    title: 'The fairness test runs on real predictions',
    body: 'A CSV of predictions, outcomes and protected attributes goes through disparate impact, demographic parity, equal opportunity, equalized odds and calibration, with bootstrap confidence intervals and a permutation test. One group fails the 0.80 disparate-impact threshold and the result is bound to the exact model version.',
    shows: 'Evaluation run, thresholds declared before the run, measured evidence with confidence.',
  },
  {
    n: '03',
    title: 'The release gate says no-go',
    body: 'Five checks: fairness is proven and failing; monitoring is open; data governance and human oversight are attested at a capped confidence. The impact-by-confidence matrix returns no-go, and fairmind gate exits 1 in the pipeline.',
    shows: 'Gate verdict, attestation forms, the CLI and GitHub Action in a deploy job.',
  },
  {
    n: '04',
    title: 'A pack workflow runs, and stops at a person',
    body: 'The deployment release gate workflow from the Inventory pack starts a run. The trigger step fires itself; the collect and check steps are completed by the engineer and logged as manual; the ask step opens an approval request. The reviewer approves with edits, the file step maps the evidence to ISO 42001 6.1.2, EU AI Act Article 9 and NIST AI RMF GOVERN 1.7, and the ledger head is sealed.',
    shows: 'Run page, step tiles, approval card, hash-chained ledger with chain state.',
  },
  {
    n: '05',
    title: 'Remediation, retest, decision',
    body: 'The finding gets an owner and a remediation task. A retest clears the threshold and links back to the original failure. The approver requests the release decision; the evidence is sealed when it is recorded. The auditor opens the same report in read-only mode.',
    shows: 'Findings, remediation tasks, decision request, auditor mode.',
  },
];

const wontFake = [
  { strong: 'No simulated agent reasoning.', text: 'Steps that a person completes today are shown as manual, exactly as the ledger records them.' },
  { strong: 'No green dashboard.', text: 'The walkthrough ends with a no-go that becomes a go only after a measured retest.' },
  { strong: 'No certification.', text: 'The last screen is a decision record and a report, not a certificate.' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fairmind.xyz/' },
    { '@type': 'ListItem', position: 2, name: 'Walkthrough', item: 'https://fairmind.xyz/demo/' },
  ],
};
---

<Layout
  title="FairMind walkthrough: from a registered model to a gated release"
  description="Five chapters: a connector finds the system, the fairness test runs, the release gate says no-go, a pack workflow stops at a human gate and seals its ledger, and a retest turns the decision around."
  structuredData={structuredData}
>
  <div class="route-page">
    <PageHero
      signal="Walkthrough"
      title="One model, from registry to"
      accent="release decision."
      description="A guided session follows a credit-scoring model through the whole journey on your own data or ours. Every screen is the product as it is today, including the steps a person still completes by hand."
      proofs={[
        { label: 'Length', value: '45 minutes', note: 'Live, with your questions. No slides.' },
        { label: 'Data', value: 'Yours or ours', note: 'A predictions CSV is enough to run the fairness test.' },
        { label: 'Ends with', value: 'A sealed run', note: 'And a gate verdict your CI could read.' },
      ]}
      primary={{ label: 'Book a walkthrough', href: '/request-access/' }}
      secondary={{ label: 'See the platform', href: '/features/' }}
    />

    <section class="route-section" id="walkthrough" aria-labelledby="walkthrough-title">
      <header class="route-section-heading">
        <h2 id="walkthrough-title">Five chapters.</h2>
      </header>
      <div class="route-disclosure">
        {chapters.map((c, i) => (
          <details open={i === 0}>
            <summary><span>Chapter {c.n}</span><h3>{c.title}</h3></summary>
            <div><p>{c.body}</p><p><strong>You see:</strong> {c.shows}</p></div>
          </details>
        ))}
      </div>
    </section>

    <section class="route-section route-section-dark" aria-labelledby="demo-boundary-title">
      <div class="route-split">
        <div class="route-split-copy"><h2 id="demo-boundary-title">What the walkthrough will not fake.</h2><p>If a step is manual today, you will see it recorded as manual.</p></div>
        <ul class="route-checklist">{wontFake.map((w) => <li><strong>{w.strong}</strong>{w.text}</li>)}</ul>
      </div>
    </section>

    <section class="route-closing" aria-labelledby="demo-closing-title">
      <h2 id="demo-closing-title">Bring a predictions file and a question.</h2>
      <div class="route-actions"><a class="button button-primary" href="/request-access/">Book a walkthrough</a><a class="button" href="/use-cases/">Read the use cases</a></div>
    </section>
  </div>
</Layout>
