---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Request Access - Fairmind AI Governance Platform";
const pageDescription = "Request access to FairMind's AI assurance planning and evidence workflows.";
const pageKeywords = ["request access", "enterprise", "AI governance", "bias detection", "Fairmind"];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  image="/images/request-access.png"
>
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden bg-[#0F1412] border-b-4 border-[#0F1412]">
    <div class="container relative">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white">
          <span class="block">Request Enterprise</span>
          <span class="text-[#FF6B35]">Access</span>
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
          Tell us which AI assurance planning, evidence, and reviewer workflows your organization needs.
        </p>
      </div>
    </div>
  </section>

  <!-- Request Access Form Section -->
  <section class="py-20 bg-[#F3F5F0]">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="bg-white border-4 border-[#0F1412] shadow-[8px_8px_0_0_#0F1412] p-8 md:p-12">
          <div class="text-center mb-8">
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-gray-900">
              Get Started with Fairmind
            </h2>
            <p class="text-lg text-gray-600">
              Share your operating context and our team will review the request.
            </p>
          </div>
          
          <form 
            action="https://formspree.io/f/xayzqjqw" 
            method="POST"
            class="space-y-6"
          >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="firstName" class="block text-gray-700 font-semibold mb-2">First Name *</label>
                <input 
                  type="text" 
                  id="firstName" 
                  name="firstName" 
                  required
                  class="w-full px-4 py-3 border-2 border-[#0F1412] text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#0F766E] focus:ring-offset-2 transition-all duration-200"
                  placeholder="Enter your first name"
                />
              </div>
              <div>
                <label for="lastName" class="block text-gray-700 font-semibold mb-2">Last Name *</label>
                <input 
                  type="text" 
                  id="lastName" 
                  name="lastName" 
                  required
                  class="w-full px-4 py-3 border-2 border-[#0F1412] text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#0F766E] focus:ring-offset-2 transition-all duration-200"
                  placeholder="Enter your last name"
                />
              </div>
            </div>
            
            <div>
              <label for="email" class="block text-gray-700 font-semibold mb-2">Email Address *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="w-full px-4 py-3 border-2 border-[#0F1412] text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#0F766E] focus:ring-offset-2 transition-all duration-200"
                placeholder="your.email@company.com"
              />
            </div>
            
            <div>
              <label for="company" class="block text-gray-700 font-semibold mb-2">Company *</label>
              <input 
                type="text" 
                id="company" 
                name="company" 
                required
                class="w-full px-4 py-3 border-2 border-[#0F1412] text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#0F766E] focus:ring-offset-2 transition-all duration-200"
                placeholder="Your company name"
              />
            </div>
            
            <div>
              <label for="jobTitle" class="block text-gray-700 font-semibold mb-2">Job Title</label>
              <input 
                type="text" 
                id="jobTitle" 
                name="jobTitle"
                class="w-full px-4 py-3 border-2 border-[#0F1412] text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#0F766E] focus:ring-offset-2 transition-all duration-200"
                placeholder="e.g., AI Engineer, Data Scientist, CTO"
              />
            </div>
            
            <div>
              <label for="useCase" class="block text-gray-700 font-semibold mb-2">Primary Use Case</label>
              <select 
                id="useCase" 
                name="useCase"
                class="w-full px-4 py-3 border-2 border-[#0F1412] text-gray-900 focus:outline-none focus:ring-2 focus:ring-[#0F766E] focus:ring-offset-2 transition-all duration-200"
              >
                <option value="">Select your primary use case</option>
                <option value="bias-detection">AI Bias Detection</option>
                <option value="compliance">Regulatory Compliance</option>
                <option value="model-monitoring">Model Monitoring</option>
                <option value="audit-trails">Audit Trails</option>
                <option value="knowledge-graph">Knowledge Graph Analysis</option>
                <option value="geographic-bias">Geographic Bias Analysis</option>
                <option value="model-dna">Model DNA Signatures</option>
                <option value="cultural-factors">Cultural Factors Analysis</option>
                <option value="aibom">AI-BOM roadmap</option>
                <option value="other">Other</option>
              </select>
            </div>
            
            <div>
              <label for="teamSize" class="block text-gray-700 font-semibold mb-2">Team Size</label>
              <select 
                id="teamSize" 
                name="teamSize"
                class="w-full px-4 py-3 border-2 border-[#0F1412] text-gray-900 focus:outline-none focus:ring-2 focus:ring-[#0F766E] focus:ring-offset-2 transition-all duration-200"
              >
                <option value="">Select team size</option>
                <option value="1-5">1-5 people</option>
                <option value="6-25">6-25 people</option>
                <option value="26-100">26-100 people</option>
                <option value="101-500">101-500 people</option>
                <option value="Coming Soon">Coming Soon</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-gray-700 font-semibold mb-2">Additional Information</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4"
                class="w-full px-4 py-3 border-2 border-[#0F1412] text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#0F766E] focus:ring-offset-2 transition-all duration-200"
                placeholder="Tell us about your AI governance needs, specific requirements, or any questions you have..."
              ></textarea>
            </div>
            
            <div class="text-center pt-6">
              <button 
                type="submit"
                class="btn bg-[#FF6B35] text-[#0F1412] border-2 border-[#0F1412] shadow-[5px_5px_0_0_#0F1412] hover:translate-x-[5px] hover:translate-y-[5px] hover:shadow-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0F766E] transition-all duration-200 btn-lg font-bold px-8 py-4"
              >
                Request Access
                <svg class="w-5 h-5 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </button>
            </div>
            
            <p class="text-sm text-gray-500 text-center mt-4">
              We will reply with capability availability, limitations, and the next appropriate step.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
