---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/marketing/PageHero.astro';
import '../styles/pages.css';
---

<Layout
  title="Request access to FairMind | AI bias detection and governance"
  description="Request access to FairMind for AI bias testing, EU AI Act and DPDP Act evidence mapping, remediation tracking, and audit-ready assurance packages."
>
  <div class="route-page">
    <PageHero
      signal="A working session, not a generic sales funnel"
      title="Show us the"
      accent="evidence problem."
      description="Start with the evaluator output, review bottleneck, or governance decision your team cannot defend cleanly today. We will determine whether a current FairMind path fits—and say so plainly when it does not."
      proofs={[
        { label: 'Bring', value: 'A real test output', note: 'Model, data, LLM, agent, security, provenance, or environmental.' },
        { label: 'Trace', value: 'The decision boundary', note: 'Who reviews it, what threshold applies, and what happens after failure.' },
        { label: 'Leave with', value: 'A bounded next step', note: 'Pilot path, adapter target, research collaboration, or a clear not-yet.' },
      ]}
      primary={{ label: 'Describe your evidence path', href: '#access-form' }}
      secondary={{ label: 'Check current capability', href: '/#capabilities' }}
      dark={true}
    />

    <section class="route-section" id="access-form" aria-labelledby="access-title">
      <header class="route-section-heading">
        <h2 id="access-title">Tell us where the chain breaks.</h2>
        <p>No inflated maturity questionnaire. A few precise fields are enough to route the conversation to evaluation, review, governance, or research.</p>
      </header>

      <div class="route-form-grid">
        <form class="route-form" action="https://formspree.io/f/xayzqjqw" method="POST">
          <input type="hidden" name="_subject" value="New FairMind evidence-path request" />
          <div class="route-field">
            <label for="firstName">First name</label>
            <input id="firstName" name="firstName" type="text" autocomplete="given-name" required />
          </div>
          <div class="route-field">
            <label for="lastName">Last name</label>
            <input id="lastName" name="lastName" type="text" autocomplete="family-name" required />
          </div>
          <div class="route-field">
            <label for="email">Work email</label>
            <input id="email" name="email" type="email" autocomplete="email" placeholder="you@organization.com" required />
          </div>
          <div class="route-field">
            <label for="company">Organization</label>
            <input id="company" name="company" type="text" autocomplete="organization" required />
          </div>
          <div class="route-field">
            <label for="jobTitle">Role</label>
            <input id="jobTitle" name="jobTitle" type="text" autocomplete="organization-title" placeholder="Assurance lead, ML engineer, reviewer…" />
          </div>
          <div class="route-field">
            <label for="teamSize">Team size</label>
            <select id="teamSize" name="teamSize">
              <option value="">Select if useful</option>
              <option value="individual">Individual</option>
              <option value="2-10">2–10</option>
              <option value="11-50">11–50</option>
              <option value="51-plus">51+</option>
            </select>
          </div>
          <div class="route-field route-field-wide">
            <label for="useCase">Where does the evidence need to go?</label>
            <select id="useCase" name="useCase" required>
              <option value="">Choose the closest path</option>
              <option value="evaluation-evidence">Evaluation output to evidence record</option>
              <option value="safety-review">AI safety finding to human review</option>
              <option value="framework-mapping">Evidence to framework mapping</option>
              <option value="remediation-retest">Finding, remediation, and retest</option>
              <option value="environmental-research">Environmental evidence or research</option>
              <option value="adapter">Evaluator adapter or integration</option>
              <option value="other">Something else</option>
            </select>
          </div>
          <div class="route-field route-field-wide">
            <label for="message">Describe the test, artifact, or decision</label>
            <textarea id="message" name="message" placeholder="What produces the result today? Who reviews it? What must the final evidence support?" required></textarea>
          </div>
          <div class="route-form-footer">
            <p>By submitting, you agree that we may use these details to respond. Read the <a href="/privacy">Privacy Policy</a>.</p>
            <button class="button button-primary" type="submit">Send evidence-path request</button>
          </div>
        </form>

        <aside aria-label="What happens next">
          <div class="route-aside-ledger">
            <div>
              <span>01 · Triage</span>
              <strong>We identify the current capability state.</strong>
              <p>Validated, metadata-only, external-provider, unavailable, or insufficient data.</p>
            </div>
            <div>
              <span>02 · Boundary</span>
              <strong>We separate what exists from what would need building.</strong>
              <p>No roadmap feature is presented as a shipped integration.</p>
            </div>
            <div>
              <span>03 · Next step</span>
              <strong>We propose a bounded pilot or close the loop honestly.</strong>
              <p>FairMind is decision support. It does not certify AI systems or provide legal advice.</p>
            </div>
          </div>
          <p class="route-meta">Prefer email? <a href="mailto:support@fairmind.xyz">support@fairmind.xyz</a></p>
        </aside>
      </div>
    </section>
  </div>
</Layout>
