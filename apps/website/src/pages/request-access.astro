---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Request Alpha Access - FairMind";
const pageDescription = "Request access to FairMind's AI assurance planning and evidence workflows.";
const pageKeywords = ["request access", "AI governance", "assurance evidence", "human review", "FairMind"];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  image="/images/request-access.png"
>
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden bg-[#0F1412] border-b-4 border-[#0F1412]">
    <div class="container relative">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white">
          <span class="block">Request Alpha</span>
          <span class="text-[#FF6B35]">Access</span>
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
          Tell us which AI assurance planning, evidence, and reviewer workflows your organization needs.
        </p>
      </div>
    </div>
  </section>

  <!-- Request Access Form Section -->
  <section class="py-20 bg-[#F3F5F0]">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="bg-white border-4 border-[#0F1412] shadow-[8px_8px_0_0_#0F1412] p-8 md:p-12">
          <div class="text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-gray-900">
              Request Access by Email
            </h2>
            <p class="text-lg text-gray-600 mb-8">
              The alpha site does not collect access-request data. Email the team with the workflow you want to evaluate; availability and limitations are confirmed individually.
            </p>
            <a
              href="mailto:support@fairmind.xyz?subject=FairMind%20alpha%20access%20request"
              class="inline-flex items-center justify-center bg-[#FF6B35] text-[#0F1412] border-2 border-[#0F1412] shadow-[5px_5px_0_0_#0F1412] hover:translate-x-[5px] hover:translate-y-[5px] hover:shadow-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0F766E] transition-all duration-200 font-bold px-8 py-4"
            >
              Email an Access Request
            </a>
            <p class="text-sm text-gray-500 mt-6">
              Include the target workflow, operating environment, evidence needs, and whether you are requesting a research review or an internal alpha evaluation.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
