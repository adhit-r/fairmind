<aside class="rail" aria-label="Browse">
  <section class="mod frameworks">
    <h2 class="rail-h">{{> icon name="list"}}Browse by framework</h2>
    <ul>
      {{#get "tags" filter="slug:[{{@custom.topic_tags}}]" include="count.posts" limit="20"}}{{#foreach tags}}
      <li><a href="{{url}}" data-topic="{{name}}"{{#match ../tag.slug slug}} aria-current="page"{{/match}}>{{> icon name=slug size="18"}}<span class="t">{{name}}</span><b class="next" hidden></b><span class="n">{{#if count.posts}}{{count.posts}}{{else}}Soon{{/if}}</span></a></li>
      {{/foreach}}{{/get}}
    </ul>
  </section>
  <section class="mod promo">
    <h2>{{@custom.cta_title}}</h2>
    <p>{{@custom.cta_text}}</p>
    <a class="btn red" href="https://fairmind.xyz/request-access?utm_source=blog&utm_medium=rail&utm_campaign=blog">Request access {{> icon name="arrow" size="14"}}</a>
  </section>
</aside>
