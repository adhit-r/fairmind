<ul class="topics">
  {{#get "tags" filter="slug:[{{@custom.topic_tags}}]" include="count.posts" limit="20"}}{{#foreach tags}}{{#if count.posts}}
  <li>
    <h3><a href="{{url}}">{{name}}</a></h3>
    {{#if description}}<p>{{description}}</p>{{/if}}
    <p class="meta">{{#get "posts" filter="primary_tag:{{slug}}" limit="1"}}{{#foreach posts}}<span class="latest">Latest: <a href="{{url}}">{{title}}</a></span>{{/foreach}}{{/get}}<span class="topic-next" data-topic-next="{{name}}" hidden></span></p>
  </li>
  {{/if}}{{/foreach}}{{/get}}
</ul>
