{{#if @site.members_enabled}}{{#unless @member}}
<section class="news" id="subscribe" aria-labelledby="news-h">
  <h2 id="news-h">{{@custom.newsletter_title}}</h2>
  <p>{{@custom.newsletter_text}}</p>
  <form data-members-form="subscribe">
    <label for="news-email-{{#if id}}{{id}}{{else}}site{{/if}}">Work email</label>
    <div class="news-row">
      <input id="news-email-{{#if id}}{{id}}{{else}}site{{/if}}" data-members-email type="email" required autocomplete="email" aria-describedby="news-status-{{#if id}}{{id}}{{else}}site{{/if}}">
      <button class="btn" type="submit">Subscribe</button>
    </div>
    <div class="news-status" id="news-status-{{#if id}}{{id}}{{else}}site{{/if}}" role="status" aria-live="polite">
      <p class="msg ok">Check your inbox to confirm your subscription.</p>
      <p class="msg err">That did not go through. <span data-members-error></span></p>
    </div>
  </form>
</section>
{{/unless}}{{/if}}
