<article class="row">
  <time class="d" datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="D MMM YYYY"}}</time>
  <div>
    <h3><a href="{{url}}">{{title}}</a></h3>
    <p>{{excerpt words="32"}}</p>
    <p class="meta-line">{{> flags}}{{#primary_tag}}<a class="chip" href="{{url}}">{{name}}</a>{{/primary_tag}}</p>
  </div>
  <div class="r"><span>{{reading_time minute="1 min" minutes="% min"}}</span><span hidden><span data-sources></span> sources</span></div>
  <template>{{content}}</template>
</article>
