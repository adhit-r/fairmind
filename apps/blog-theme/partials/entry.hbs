<article class="entry">
  <h3><a href="{{url}}">{{title}}</a></h3>
  <p class="dek">{{excerpt words="36"}}</p>
  <p class="meta">{{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}{{#primary_author}}<span>{{name}}</span>{{/primary_author}}<time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="D MMM YYYY"}}</time><span>{{reading_time minute="1 min read" minutes="% min read"}}</span></p>
</article>
