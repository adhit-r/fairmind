{{!< default}}
<div class="wrap article page">
  <aside class="toc-col"></aside>
  <article class="doc">
    <h1>{{#match statusCode 404}}This page is not in the index{{else}}Something went wrong{{/match}}</h1>
    <p class="dek">{{message}}. Search the guides or go back to the <a href="{{@site.url}}/">home page</a>.</p>
    <button class="bigsearch" type="button" data-ghost-search>{{> icon name="search" size="18"}}<span>Search guides</span><b>Search</b></button>
  </article>
</div>
