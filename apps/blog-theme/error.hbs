{{!< default}}
<header class="page-head wrap-read">
  <h1>{{#match statusCode 404}}This page is not here{{else}}Something went wrong{{/match}}</h1>
  <p class="dek">{{#match statusCode 404}}The address may be mistyped, or the guide may have moved.{{else}}{{message}}{{/match}} Search the guides or start from the <a href="{{@site.url}}/">latest guides</a>.</p>
  <button class="btn" type="button" data-ghost-search aria-haspopup="dialog">{{> icon name="search" size="16"}} Search guides</button>
</header>
