{{!< default}}
{{#author}}
<header class="page-head wrap-read">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="{{@site.url}}/">Home</a></nav>
  <h1>{{name}}</h1>
  {{#if bio}}<p class="dek">{{bio}}</p>{{/if}}
</header>
{{/author}}
<section class="feed wrap-read" aria-labelledby="author-feed-h">
  <h2 class="sec" id="author-feed-h">{{plural pagination.total empty="No guides yet" singular="% guide" plural="% guides"}}</h2>
  {{#foreach posts}}{{> entry}}{{else}}<p class="empty">No guides published by this author yet.</p>{{/foreach}}
  {{pagination}}
</section>
